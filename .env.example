# ─── Database ───
DATABASE_URL="file:./prisma/dev.db"

# ─── Server ───
# Defaults to 127.0.0.1 for local-only access.
# Set HOST="0.0.0.0" only when you intentionally need LAN/public access.
# HOST="127.0.0.1"
# PORT="3101"
# CHRONA_WEB_DIST="apps/web/dist"
# ALLOWED_ORIGINS="http://localhost:3100,http://localhost:3101"   # Comma-separated; omit for "*"

# ─── Security ───
# API_KEY="sk-chrona-..."   # If set, all /api/* routes require Authorization: Bearer <key>
# Required when HOST="0.0.0.0" unless CHRONA_UNSAFE_PUBLIC_BIND="1" is set explicitly.
# CHRONA_UNSAFE_PUBLIC_BIND="1"

# ─── Frontend ───
# VITE_API_BASE_URL="http://localhost:3101"
