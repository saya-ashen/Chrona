# ─── Database ───
# Defaults to chrona.db in the platform user data directory.
# CHRONA_DATA_DIR="/absolute/path/to/chrona-data"
# DATABASE_URL="file:/absolute/path/to/chrona-data/chrona.db"

# ─── Server ───
# Defaults to 127.0.0.1 for local-only access.
# Set HOST="0.0.0.0" only when you intentionally need LAN/public access.
# HOST="127.0.0.1"
# PORT="3101"
# ALLOWED_ORIGINS="http://localhost:3100,http://localhost:3101"   # Comma-separated; omit for "*"

# ─── Security ───
# API_KEY="sk-chrona-..."   # Kernel HTTP authentication; applications own their HTTP authentication.
# Required when HOST="0.0.0.0" unless CHRONA_UNSAFE_PUBLIC_BIND="1" is set explicitly.
# CHRONA_UNSAFE_PUBLIC_BIND="1"

# ─── Trusted local runtime ───
# Unset/empty defaults to trusted-local; this is the only supported execution mode.
# Modules and Provider use the host user's OS permissions, without OS isolation
# or a hard virtual-memory limit. Chrona routing, approvals and budgets still apply.
# CHRONA_STEWARD_EXECUTION_MODE="trusted-local"
# Migration: remove required-isolation and any nonempty
# CHRONA_STEWARD_SANDBOX_BWRAP setting; they explicitly error instead of falling back.
# Module packages are program names already installed on the Chrona process PATH.
# Chrona does not provision them through Nix. Python libraries need host uv and
# Python plus uv.lock; uv sync uses --no-python-downloads.
# runtimes.json declares entry interpreters/checks; .sh entries need a host shell.
# S4 process/IPC portability and three-OS acceptance are still pending.

# Optional, explicit local release inputs for owner installation.
# CHRONA_MODULE_RESOURCES="/absolute/path/to/release-inputs/external"
