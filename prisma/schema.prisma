generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "../packages/db/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id String @id @default(uuid())
  name String
  settings Json @default(dbgenerated("'{\"notifications\":{\"dailyCap\":5,\"quietHours\":{\"start\":\"23:00\",\"end\":\"08:00\"},\"timezone\":\"Asia/Shanghai\",\"digestAt\":\"09:00\"}}'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  modules Module[]
  generations Generation[]
  schedules Schedule[]
  runs Run[]
  messages Message[]
  approvals Approval[]
  grants Grant[]
  preferences Preference[]
  invocations ModuleInvocation[]
  audits Audit[]
  stewardState StewardState?
  executions ExecutionAttempt[]
}

/// A conversation with the Provider. Entries choose keys; at most one active session per key (enforced by Chrona).
model Session {
  id String @id @default(uuid())
  workspaceId String
  key String
  source String
  title String?
  status String @default("active")
  moduleId String?
  originSessionId String?
  providerSessionId String?
  /// The entry module (e.g. qq) that brings this conversation's messages and receives its replies.
  entryModuleId String?
  /// Module names whose tools are directly exposed in this session's catalog.
  focus Json @default(dbgenerated("'[\"files\"]'"))
  lastActivityAt DateTime @default(now())
  createdAt DateTime @default(now())
  endedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  origin Session? @relation("SessionOrigin", fields: [originSessionId], references: [id], onDelete: SetNull)
  spawned Session[] @relation("SessionOrigin")
  messages Message[]
  runs Run[]
  schedules Schedule[]
  @@index([workspaceId, key, status])
  @@index([workspaceId, source, lastActivityAt])
}

model Module {
  id String @id @default(uuid())
  workspaceId String
  name String
  builtin Boolean @default(false)
  activeHash String?
  dataSchema Int?
  status String @default("active")
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  executions ExecutionAttempt[]
  versions ModuleVersion[]
  runs ModuleRun[]
  calls ModuleCall[]
  schedules Schedule[]
  sessions Session[]
  approvals Approval[]
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model ModuleVersion {
  id String @id @default(uuid())
  moduleId String
  hash String
  manifest Json
  intent Json
  source String
  report Json
  status String
  createdAt DateTime @default(now())
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([moduleId, hash])
  @@index([moduleId, status, createdAt])
}

model Generation {
  id String @id @default(uuid())
  workspaceId String
  seq Int
  modules Json
  reason String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, seq])
}

model ModuleRun {
  id String @id @default(uuid())
  moduleId String
  hash String
  triggerId String
  firedAt DateTime
  exitCode Int
  output Json?
  error String?
  createdAt DateTime @default(now())
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@index([moduleId, createdAt])
  @@index([moduleId, hash, firedAt])
}

model ModuleCall {
  id String @id @default(uuid())
  moduleId String
  hash String
  moduleRunId String?
  eventKey String?
  method String
  key String
  status String
  error String?
  createdAt DateTime @default(now())
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@index([moduleId, method, key, status])
  @@index([moduleRunId])
}

/// A call routed by Chrona to a module tool. Async calls are stored here until delivered; sync calls are only recorded.
/// `caller` is Chrona's record of who called (`module:<id>`, `kernel`, `provider:<runId>`, `owner`), never caller-supplied.
model ModuleInvocation {
  id String @id @default(uuid())
  workspaceId String
  caller String
  callerModuleId String?
  callerHash String?
  target String
  tool String
  args Json
  key String
  /// Module names on the call path, the caller last.
  chain Json @default(dbgenerated("'[]'"))
  mode String
  /// The target tool declared itself safe to run twice when the call was made.
  idempotent Boolean @default(false)
  status String @default("queued")
  attempts Int @default(0)
  nextAttemptAt DateTime?
  leaseToken String?
  leaseUntil DateTime?
  output Json?
  error String?
  reply Boolean @default(false)
  replyAttempts Int @default(0)
  repliedAt DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, caller, target, tool, key])
  @@index([workspaceId, status, nextAttemptAt])
  @@index([workspaceId, reply, repliedAt])
}

model Schedule {
  id String @id @default(uuid())
  workspaceId String
  originSessionId String?
  mode String
  rule Json
  text String
  moduleId String?
  triggerId String?
  /// Dynamic module schedules (remind, v2-24 module timers whose key is `text`) carry their data here.
  payload Json?
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  until DateTime?
  status String @default("active")
  nextAt DateTime?
  lastAt DateTime?
  lastResult String?
  failures Int @default(0)
  label String?
  createdBy String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  origin Session? @relation(fields: [originSessionId], references: [id], onDelete: SetNull)
  @@index([workspaceId, status, nextAt])
  @@index([moduleId, status])
}

model Run {
  id String @id @default(uuid())
  workspaceId String
  sessionId String?
  lane String
  trigger String
  status String @default("queued")
  provider String
  execution ExecutionAttempt?
  tokenHash String @unique
  leaseUntil DateTime?
  deadlineAt DateTime?
  prompt String
  summary String?
  label String?
  cwd String
  toolCalls Json @default(dbgenerated("'[]'"))
  error String?
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([workspaceId, lane, status, createdAt])
  @@index([workspaceId, status, leaseUntil])
  @@index([workspaceId, status, deadlineAt])
  @@index([sessionId, createdAt])
}

/// Run owns lifecycle and queue status. This row binds admission, authorization and retained evidence.
model ExecutionAttempt {
  id String @id @default(uuid())
  workspaceId String
  ownerId String
  /// owner or module:<immutable module id>; hash remains separate authorization evidence.
  callerKey String
  moduleId String?
  callerHash String?
  workId String
  commandKey String
  requestDigest String
  runId String @unique
  projectRef String
  projectDigest String
  /// P2 device attempts have no server filesystem path; v1/server retain their canonical cwd.
  resolvedCwd String?
  executorId String @default("server")
  executorGeneration Int @default(1)
  mappingRevision Int @default(1)
  directoryIdentity String?
  queueExpiresAt DateTime?
  workspaceRef String?
  workspaceMode String?
  sourceManifest Json?
  sourceReceipt Json?
  logDir String
  baseline String
  budget Json
  cancelRequestedAt DateTime?
  capabilityRevokedAt DateTime?
  stopConfirmedAt DateTime?
  stopEvidence Json?
  /// Canonical cwd while occupied, NULL only after confirmed stop; SQLite allows multiple released NULLs.
  heldDirectory String? @unique
  /// Current charges: active headroom, terminal actual bytes; never historical maximum reservations.
  snapshotChargeBytes Int @default(0)
  controlChargeBytes Int @default(0)
  detailBytes Int @default(0)
  highWatermark Int @default(0)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  run Run @relation(fields: [runId], references: [id], onDelete: Restrict)
  events ExecutionDetail[]
  snapshot ExecutionSnapshot?
  controls ExecutionControl[]
  commands ExecutionCommand[]
  assignment ExecutorAssignment?
  @@index([executorId, stopConfirmedAt])
  @@index([moduleId, stopConfirmedAt])
  @@unique([workspaceId, ownerId, callerKey, commandKey])
  @@index([workspaceId, ownerId, workId, createdAt])
}

/// Normalized, redacted v1 events only; no raw Provider envelopes.
model ExecutionDetail {
  attemptId String
  seq Int
  event Json
  bytes Int
  expiresAt DateTime
  attempt ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@id([attemptId, seq])
  @@index([expiresAt])
}

model ExecutionSnapshot {
  attemptId String @id
  snapshot Json
  bytes Int
  expiresAt DateTime
  attempt ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@index([expiresAt])
}

/// Four fixed v1 slots, validated by G before upsert in F's transaction.
model ExecutionControl {
  attemptId String
  slot String
  fact Json
  bytes Int
  attempt ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@id([attemptId, slot])
}

/// F deduplicates send/answer/cancel without storing their sensitive input again.
model ExecutionCommand {
  attemptId String
  commandKey String
  operation String
  requestDigest String
  receipt Json
  /// One-shot inject transport intent, never the text or an answer body.
  offeredAt DateTime?
  effect String?
  createdAt DateTime @default(now())
  attempt ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  @@id([attemptId, commandKey])
}

/// Device security generation and connection incarnation are distinct fences. No plaintext credentials.
model ExecutionExecutor {
  id String @id
  workspaceId String
  ownerId String
  label String
  credentialHash String @unique
  generation Int @default(1)
  revokedAt DateTime?
  authorizedUntil DateTime?
  incarnation String?
  reconciledAt DateTime?
  lastSeenAt DateTime?
  createdAt DateTime @default(now())
  pairings ExecutorPairing[]
  assignments ExecutorAssignment[]
  @@index([workspaceId, ownerId])
}

/// A consumed pairing is a stable receipt; the original credential hash cannot resurrect a revoked device.
model ExecutorPairing {
  codeHash String @id
  workspaceId String
  ownerId String
  expiresAt DateTime
  receiptExpiresAt DateTime
  executorId String?
  credentialHash String?
  consumedAt DateTime?
  executor ExecutionExecutor? @relation(fields: [executorId], references: [id], onDelete: Restrict)
  @@index([receiptExpiresAt])
}

/// One transport journal for an already claimed Run, never another scheduling queue.
model ExecutorAssignment {
  attemptId String @id
  assignmentId String @unique
  executorId String
  generation Int
  incarnation String
  launchDigest String?
  launch Json?
  preparedAt DateTime?
  offeredAt DateTime?
  startedAt DateTime?
  processIdentity Json?
  sourceHighWatermark Int @default(0)
  sourceProducedThrough Int @default(0)
  receiptCount Int @default(0)
  receiptBytes Int @default(0)
  finalDigest String?
  final Json?
  finalizedAt DateTime?
  tombstoneDigest String?
  attempt ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Restrict)
  executor ExecutionExecutor @relation(fields: [executorId], references: [id], onDelete: Restrict)
  receipts ExecutorSourceReceipt[]
  @@index([executorId, generation])
}

/// Retained independently of detail retention; no payloads, credentials, questions or answers.
model ExecutorSourceReceipt {
  attemptId String
  sourceSeq Int
  digest String
  throughSourceSeq Int
  storedSeq Int?
  bytes Int
  assignment ExecutorAssignment @relation(fields: [attemptId], references: [attemptId], onDelete: Restrict)
  @@id([attemptId, sourceSeq])
}

model Message {
  id String @id @default(uuid())
  workspaceId String
  direction String
  channel String
  text String
  sessionId String
  attachments Json @default(dbgenerated("'[]'"))
  quotedMessageId String?
  externalId String?
  at DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  quotedMessage Message? @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageQuote")
  @@unique([workspaceId, externalId])
  @@index([sessionId, at])
}

model Approval {
  id String @id @default(uuid())
  workspaceId String
  moduleId String?
  action String
  title String
  detail String
  preview String
  payload Json
  scope String @default("once")
  grantId String?
  status String @default("open")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  grant Grant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  @@index([workspaceId, status, createdAt])
  @@index([moduleId, status])
}

model Grant {
  id String @id @default(uuid())
  workspaceId String
  action String
  mode String
  scope Json
  once Boolean @default(false)
  consumedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  revokedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvals Approval[]
  @@index([workspaceId, action, revokedAt, expiresAt])
}

model Preference {
  id String @id @default(uuid())
  workspaceId String
  text String
  origin String
  topic String @default("general")
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model Audit {
  id String @id @default(uuid())
  workspaceId String
  kind String
  subjectId String?
  actorKey String
  details Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, subjectId, createdAt])
}

model StewardState {
  workspaceId String @id
  lastTickAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  providerName String @default("unconfigured")
  providerAvailable Boolean @default(false)
  providerSandboxed Boolean @default(false)
  providerLastError String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
