generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "../packages/db/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id String @id @default(uuid())
  name String
  // Prisma 7 SQLite diff requires SQL-quoted JSON defaults.
  settings Json @default(dbgenerated("'{\"notifications\":{\"dailyCap\":5,\"quietHours\":{\"start\":\"23:00\",\"end\":\"08:00\"},\"timezone\":\"Asia/Shanghai\",\"digestAt\":\"09:00\"}}'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  affairs Affair[]
  entries AffairEntry[]
  results AffairResult[]
  runs AffairRun[]
  asks Ask[]
  followUps FollowUp[]
  grants Grant[]
  connections SourceConnection[]
  events InboundEvent[]
  assessments EventAssessment[]
  notifications Notification[]
  messages ChatMessage[]
  preferences Preference[]
  tools ManagedTool[]
  toolVersions ToolVersion[]
  toolRuns ToolRun[]
  panelEntries PanelEntry[]
  audits Audit[]
  stewardState StewardState?
}

model Affair {
  id String @id @default(uuid())
  workspaceId String
  title String
  goal String @default("")
  summary String @default("")
  nextStep String @default("")
  status String @default("active")
  agentState String @default("queued")
  handling Json?
  cadenceSeconds Int?
  notify String @default("digest")
  connectionId String?
  lastCheckAt DateTime?
  nextCheckAt DateTime?
  ref String?
  revision Int @default(1)
  failures Int @default(0)
  wakeReason String @default("new_request")
  nextRunAt DateTime?
  leaseUntil DateTime?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastActivityAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SourceConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  entries AffairEntry[]
  results AffairResult[]
  runs AffairRun[]
  asks Ask[]
  followUps FollowUp[]
  events InboundEvent[]
  notifications Notification[]
  messages ChatMessage[]
  tools ManagedTool[]
  @@unique([workspaceId, ref])
  @@index([workspaceId, status, lastActivityAt])
  @@index([workspaceId, agentState, nextRunAt])
  @@index([workspaceId, status, nextCheckAt])
  @@index([workspaceId, agentState, leaseUntil])
  @@index([connectionId])
}

model AffairEntry {
  id String @id @default(uuid())
  workspaceId String
  affairId String
  at DateTime @default(now())
  actor String
  kind String
  text String
  data Json?
  idempotencyKey String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair @relation(fields: [affairId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, idempotencyKey])
  @@index([affairId, at])
  @@index([workspaceId, kind, at])
}

/// Append-only versions; feedback belongs to AffairEntry, not an edit to this row.
model AffairResult {
  id String @id @default(uuid())
  workspaceId String
  affairId String
  version Int
  title String
  summary String @default("")
  body String
  sources Json @default(dbgenerated("'[]'"))
  limitations String @default("")
  nextSteps Json @default(dbgenerated("'[]'"))
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair @relation(fields: [affairId], references: [id], onDelete: Cascade)
  @@unique([affairId, version])
  @@index([workspaceId, createdAt])
}

/// Only the hash of the short-lived capability is persisted.
model AffairRun {
  id String @id @default(uuid())
  workspaceId String
  affairId String
  number Int
  wakeReason String
  status String @default("running")
  affairRevision Int
  tokenHash String @unique
  leaseUntil DateTime
  deadlineAt DateTime
  toolCalls Json @default(dbgenerated("'[]'"))
  webCalls Int @default(0)
  observedSources Json @default(dbgenerated("'[]'"))
  error String?
  startedAt DateTime @default(now())
  endedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair @relation(fields: [affairId], references: [id], onDelete: Cascade)
  @@unique([affairId, number])
  @@index([workspaceId, status, leaseUntil])
  @@index([workspaceId, status, deadlineAt])
  @@index([affairId, startedAt])
}

model Ask {
  id String @id @default(uuid())
  workspaceId String
  affairId String?
  kind String
  status String @default("open")
  title String
  detail String @default("")
  questions Json @default(dbgenerated("'[]'"))
  action String?
  actionPayload Json?
  affairRevision Int?
  topic String?
  answer String?
  decision String?
  approvalScope String?
  ref String?
  idempotencyKey String?
  revision Int @default(1)
  expiresAt DateTime?
  cooldownUntil DateTime?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: Cascade)
  notifications Notification[]
  @@unique([workspaceId, ref])
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, createdAt])
  @@index([affairId, status])
  @@index([workspaceId, topic, resolvedAt])
  @@index([workspaceId, status, expiresAt])
}

model FollowUp {
  id String @id @default(uuid())
  workspaceId String
  affairId String
  note String
  dueAt DateTime
  status String @default("pending")
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair @relation(fields: [affairId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, dueAt])
  @@index([affairId, dueAt])
}

model Grant {
  id String @id @default(uuid())
  workspaceId String
  action String
  mode String
  scope Json
  origin String @default("user")
  once Boolean @default(false)
  consumedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  revokedAt DateTime?
  revision Int @default(1)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, action, revokedAt, expiresAt])
}

model SourceConnection {
  id String @id @default(uuid())
  workspaceId String
  kind String
  label String
  mode String @default("poll")
  status String @default("needs_authorization")
  config Json @default(dbgenerated("'{}'"))
  cursor String?
  readScopes Json @default(dbgenerated("'[]'"))
  writeScopes Json @default(dbgenerated("'[]'"))
  revision Int @default(1)
  pollIntervalSeconds Int?
  baselineAt DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastError String?
  nextCheckAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  coverageNote String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events InboundEvent[]
  affairs Affair[]
  @@index([workspaceId, status, mode, nextCheckAt])
}

model InboundEvent {
  id String @id @default(uuid())
  workspaceId String
  connectionId String
  externalId String
  status String @default("pending")
  title String
  body String
  url String?
  occurredAt DateTime
  receivedAt DateTime @default(now())
  affairId String?
  disposition String?
  attempts Int @default(0)
  nextAttemptAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  lastError String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection SourceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: SetNull)
  assessments EventAssessment[]
  @@unique([connectionId, externalId])
  @@index([workspaceId, status, nextAttemptAt])
  @@index([affairId, occurredAt])
}

model EventAssessment {
  id String @id @default(uuid())
  workspaceId String
  eventId String
  assessor String
  disposition String
  whatHappened String
  whyItMatters String
  important Boolean @default(false)
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event InboundEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([eventId, createdAt])
}

model Notification {
  id String @id @default(uuid())
  workspaceId String
  affairId String?
  askId String?
  level String @default("digest")
  channel String
  status String @default("queued")
  title String
  body String
  idempotencyKey String
  recipient String?
  link String?
  receiptRef String?
  attempts Int @default(0)
  lastError String?
  nextAttemptAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  acknowledgedAt DateTime?
  feedback String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: SetNull)
  ask Ask? @relation(fields: [askId], references: [id], onDelete: SetNull)
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, level, nextAttemptAt])
  @@index([workspaceId, channel, sentAt])
  @@index([affairId, createdAt])
  @@index([askId])
}

model ChatMessage {
  id String @id @default(uuid())
  workspaceId String
  direction String
  channel String
  text String
  affairId String?
  externalId String?
  at DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: SetNull)
  @@unique([workspaceId, channel, externalId])
  @@index([workspaceId, at])
  @@index([affairId, at])
}

model Preference {
  id String @id @default(uuid())
  workspaceId String
  text String
  origin String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

/// Current version is projected from ToolVersion; never overwrite approved source.
model ManagedTool {
  id String @id @default(uuid())
  workspaceId String
  affairId String?
  kind String
  name String
  purpose String
  rationale String @default("")
  version Int @default(1)
  state String @default("draft")
  approvedVersion Int?
  revision Int @default(1)
  lastRunAt DateTime?
  lastRunOk Boolean?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: Cascade)
  versions ToolVersion[]
  runs ToolRun[]
  entries PanelEntry[]
  @@index([workspaceId, state])
  @@index([affairId])
}

model PanelEntry {
  id String @id @default(uuid())
  workspaceId String
  toolId String
  values Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tool ManagedTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@index([toolId, createdAt])
}

model ToolVersion {
  id String @id @default(uuid())
  workspaceId String
  toolId String
  version Int
  script Json?
  spec Json?
  contentHash String
  validationSummary String?
  approvedAt DateTime?
  approvedBy String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tool ManagedTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  runs ToolRun[]
  @@unique([toolId, version])
  @@index([workspaceId, createdAt])
}

model ToolRun {
  id String @id @default(uuid())
  workspaceId String
  toolId String
  version Int
  status String @default("running")
  idempotencyKey String
  input Json @default(dbgenerated("'{}'"))
  output Json?
  error String?
  leaseUntil DateTime?
  startedAt DateTime @default(now())
  endedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tool ManagedTool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  toolVersion ToolVersion @relation(fields: [toolId, version], references: [toolId, version], onDelete: Cascade)
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, leaseUntil])
  @@index([toolId, startedAt])
}

model Audit {
  id String @id @default(uuid())
  workspaceId String
  kind String
  subjectId String?
  actorKey String
  details Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, subjectId, createdAt])
}

model StewardState {
  workspaceId String @id
  lastTickAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  agentName String @default("unconfigured")
  agentAvailable Boolean @default(false)
  agentLastError String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
