generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "../packages/db/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id String @id @default(uuid())
  name String
  settings Json @default(dbgenerated("'{\"notifications\":{\"dailyCap\":5,\"quietHours\":{\"start\":\"23:00\",\"end\":\"08:00\"},\"timezone\":\"Asia/Shanghai\",\"digestAt\":\"09:00\"}}'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  affairs Affair[]
  schedules Schedule[]
  runs Run[]
  messages Message[]
  activities Activity[]
  approvals Approval[]
  grants Grant[]
  preferences Preference[]
  notifications Notification[]
  connectors Connector[]
  inboundItems InboundItem[]
  audits Audit[]
  stewardState StewardState?
}

model Affair {
  id String @id @default(uuid())
  workspaceId String
  title String
  status String @default("active")
  dirName String
  sessionId String?
  lastActivityAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  revision Int @default(1)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  schedules Schedule[]
  runs Run[]
  messages Message[]
  activities Activity[]
  approvals Approval[]
  notifications Notification[]
  connectors Connector[]
  @@unique([workspaceId, dirName])
  @@index([workspaceId, status, lastActivityAt])
}

model Schedule {
  id String @id @default(uuid())
  workspaceId String
  affairId String
  mode String
  rule Json
  text String
  command String?
  until DateTime?
  status String @default("active")
  nextAt DateTime?
  lastAt DateTime?
  lastResult String?
  lastOutputHash String?
  failures Int @default(0)
  label String?
  createdBy String
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair @relation(fields: [affairId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, nextAt])
  @@index([affairId, status, nextAt])
}

model Run {
  id String @id @default(uuid())
  workspaceId String
  affairId String?
  lane String
  trigger String
  status String @default("queued")
  provider String
  tokenHash String @unique
  leaseUntil DateTime?
  deadlineAt DateTime?
  conversationKey String?
  prompt String
  summary String?
  label String?
  cwd String
  toolCalls Json @default(dbgenerated("'[]'"))
  error String?
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: SetNull)
  @@index([workspaceId, lane, status, createdAt])
  @@index([workspaceId, status, leaseUntil])
  @@index([workspaceId, status, deadlineAt])
  @@index([workspaceId, conversationKey, status])
  @@index([affairId, createdAt])
}

model Message {
  id String @id @default(uuid())
  workspaceId String
  direction String
  channel String
  text String
  attachments Json @default(dbgenerated("'[]'"))
  affairId String?
  quotedMessageId String?
  externalId String?
  conversationKey String
  at DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: SetNull)
  quotedMessage Message? @relation("MessageQuote", fields: [quotedMessageId], references: [id], onDelete: SetNull)
  replies Message[] @relation("MessageQuote")
  @@unique([workspaceId, externalId])
  @@index([workspaceId, conversationKey, at])
  @@index([affairId, at])
}

model Activity {
  id String @id @default(uuid())
  workspaceId String
  affairId String
  at DateTime @default(now())
  actor String
  kind String
  text String
  data Json?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair @relation(fields: [affairId], references: [id], onDelete: Cascade)
  @@index([affairId, at])
  @@index([workspaceId, at])
}

model Approval {
  id String @id @default(uuid())
  workspaceId String
  affairId String?
  action String
  title String
  detail String
  preview String
  payload Json
  scope String @default("once")
  grantId String?
  status String @default("open")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: Cascade)
  grant Grant? @relation(fields: [grantId], references: [id], onDelete: SetNull)
  notifications Notification[]
  @@index([workspaceId, status, createdAt])
  @@index([affairId, status])
}

model Grant {
  id String @id @default(uuid())
  workspaceId String
  action String
  mode String
  scope Json
  once Boolean @default(false)
  consumedAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  revokedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  approvals Approval[]
  @@index([workspaceId, action, revokedAt, expiresAt])
}

model Preference {
  id String @id @default(uuid())
  workspaceId String
  text String
  origin String
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model Notification {
  id String @id @default(uuid())
  workspaceId String
  affairId String?
  approvalId String?
  level String @default("digest")
  channel String
  status String @default("queued")
  title String
  body String
  idempotencyKey String
  recipient String?
  link String?
  receiptRef String?
  attempts Int @default(0)
  lastError String?
  nextAttemptAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  createdAt DateTime @default(now())
  sentAt DateTime?
  acknowledgedAt DateTime?
  feedback String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: SetNull)
  approval Approval? @relation(fields: [approvalId], references: [id], onDelete: SetNull)
  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, status, level, nextAttemptAt])
  @@index([workspaceId, channel, sentAt])
  @@index([affairId, createdAt])
  @@index([approvalId])
}

model Connector {
  id String @id @default(uuid())
  workspaceId String
  kind String
  label String
  status String @default("active")
  affairId String?
  settings Json @default(dbgenerated("'{}'"))
  cursor String?
  secretRef String?
  canSend Boolean @default(false)
  failures Int @default(0)
  nextSyncAt DateTime?
  lastSyncAt DateTime?
  lastError String?
  coverageNote String @default("")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  affair Affair? @relation(fields: [affairId], references: [id], onDelete: SetNull)
  items InboundItem[]
  @@index([workspaceId, status, nextSyncAt])
  @@index([affairId])
}

model InboundItem {
  id String @id @default(uuid())
  workspaceId String
  connectorId String
  externalId String
  from String
  subject String
  receivedAt DateTime
  path String?
  status String @default("new")
  ruleNote String?
  action String @default("batch")
  batchId String?
  deliverAt DateTime?
  deliveredAt DateTime?
  attempts Int @default(0)
  leaseUntil DateTime?
  leaseToken String?
  lastError String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connector Connector @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  @@unique([connectorId, externalId])
  @@index([workspaceId, status, deliverAt])
  @@index([connectorId, status, receivedAt])
  @@index([workspaceId, batchId])
}

model Audit {
  id String @id @default(uuid())
  workspaceId String
  kind String
  subjectId String?
  actorKey String
  details Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, subjectId, createdAt])
}

model StewardState {
  workspaceId String @id
  lastTickAt DateTime?
  leaseUntil DateTime?
  leaseToken String?
  providerName String @default("unconfigured")
  providerAvailable Boolean @default(false)
  providerSandboxed Boolean @default(false)
  providerLastError String?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}
