generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "../packages/db/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum WorkspaceStatus {
  Active
  Archived
}

enum TaskStatus {
  Draft
  Ready
  Queued
  Running
  WaitingForInput
  WaitingForApproval
  Scheduled
  Blocked
  Failed
  Completed
  Done
  Cancelled
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

enum ScheduleStatus {
  Unscheduled
  Scheduled
  InProgress
  AtRisk
  Interrupted
  Overdue
  Completed
}

enum ScheduleSource {
  human
  ai
  system
}

enum ScheduleProposalStatus {
  Pending
  Accepted
  Rejected
}

enum RunStatus {
  Pending
  Running
  WaitingForInput
  WaitingForApproval
  Failed
  Completed
  Cancelled
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
  EditedAndApproved
  Expired
}

enum ArtifactType {
  file
  patch
  summary
  report
  terminal_output
  url
}

enum MemoryScope {
  user
  workspace
  project
  task
}

enum MemorySourceType {
  user_input
  agent_inferred
  imported
  system_rule
  plan_layer
}

enum MemoryStatus {
  Active
  Inactive
  Conflicted
  Expired
}

enum TaskPlanStatus {
  Draft
  Accepted
  Superseded
  Archived
}

enum TaskDependencyType {
  blocks
  relates_to
  child_of
}

model Workspace {
  id                   String                @id @default(cuid())
  name                 String
  description          String?
  defaultRuntime       String
  status               WorkspaceStatus
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  tasks                Task[]
  approvals            Approval[]
  artifacts            Artifact[]
  memories             Memory[]
  events               Event[]
  rawEventLogs         RawEventLog[]
  toolInvocations      ToolInvocation[]
  taskTimelineItems    TaskTimelineItem[]
  taskDependencies     TaskDependency[]
  taskProjections      TaskProjection[]
  scheduleProposals    ScheduleProposal[]
  workBlocks           WorkBlock[]
  executionSessions    ExecutionSession[]
  taskPlans            TaskPlan[]
  taskPlanRuns         TaskPlanRun[]
  taskPlanNodeAttempts TaskPlanNodeAttempt[]
  taskPlanProviderRuns TaskPlanProviderRun[]
  taskPlanLayers       TaskPlanLayer[]
  graphVersions        GraphVersion[]
  graphMutations       GraphMutationRecord[]
  reconciliationEvents ReconciliationEvent[]
  schedulerEvents      SchedulerEvent[]
}

model Task {
  id                   String                 @id @default(cuid())
  workspaceId          String
  title                String
  description          String?
  executionRuntime     String
  executionConfig      Json
  status               TaskStatus
  priority             TaskPriority
  autoPlanGeneration   Boolean                @default(false)
  autoExecute          Boolean                @default(false)
  parentTaskId         String?
  dueAt                DateTime?
  blockReason          Json?
  defaultSessionId     String?
  latestRunId          String?
  latestEventId        String?
  latestRawEventId     String?
  blockedByEventId     String?
  blockedByRawEventId  String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  completedAt          DateTime?
  workspace            Workspace              @relation(fields: [workspaceId], references: [id])
  runs                 Run[]
  sessions             TaskSession[]          @relation("TaskSessions")
  approvals            Approval[]
  artifacts            Artifact[]
  memories             Memory[]
  events               Event[]
  rawEventLogs         RawEventLog[]
  toolInvocations      ToolInvocation[]
  timelineItems        TaskTimelineItem[]
  projection           TaskProjection?
  dependencies         TaskDependency[]       @relation("TaskDependencies")
  dependentTasks       TaskDependency[]       @relation("TaskDependents")
  scheduleProposals    ScheduleProposal[]
  assistantMessages    TaskAssistantMessage[]
  workBlocks           WorkBlock[]
  executionSessions    ExecutionSession[]
  taskPlans            TaskPlan[]
  taskPlanRuns         TaskPlanRun[]
  taskPlanNodeAttempts TaskPlanNodeAttempt[]
  taskPlanProviderRuns TaskPlanProviderRun[]
  taskPlanLayers       TaskPlanLayer[]
  graphVersions        GraphVersion[]
  graphMutations       GraphMutationRecord[]
  reconciliationEvents ReconciliationEvent[]
  schedulerEvents      SchedulerEvent[]

  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([defaultSessionId])
}

enum GraphMutationStatus {
  Pending
  Applied
  Rejected
  Cancelled
}

model SchedulerLease {
  name        String   @id
  ownerId     String
  expiresAt   DateTime
  heartbeatAt DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([expiresAt])
}

model GraphVersion {
  id          String    @id @default(cuid())
  workspaceId String
  taskId      String
  version     Int
  graph       Json
  createdBy   String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([workspaceId, taskId, version])
}

model GraphMutationRecord {
  id               String              @id @default(cuid())
  workspaceId      String
  taskId           String
  baseGraphVersion Int
  operation        String
  status           GraphMutationStatus @default(Pending)
  payload          Json
  validationResult Json?
  affectedNodeIds  Json?
  createdBy        String
  createdAt        DateTime            @default(now())
  appliedAt        DateTime?
  workspace        Workspace           @relation(fields: [workspaceId], references: [id])
  task             Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([taskId, baseGraphVersion, status])
}

model ReconciliationEvent {
  id             String    @id @default(cuid())
  workspaceId    String
  taskId         String
  graphVersion   Int
  executionState String
  currentNodeId  String?
  issues         Json?
  repairActions  Json?
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([taskId, graphVersion, createdAt])
}

model SchedulerEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  taskId       String
  graphVersion Int?
  eventType    String
  reason       String?
  payload      Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventType, createdAt])
  @@index([taskId, createdAt])
}

model TaskSession {
  id                 String   @id @default(cuid())
  taskId             String
  runtimeName        String
  sessionKey         String   @unique
  label              String?
  status             String   @default("idle")
  lastRunStatus      String?
  activeRunId        String?
  lastRunRef         String?
  createdByFramework Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  task               Task     @relation("TaskSessions", fields: [taskId], references: [id], onDelete: Cascade)
  runs               Run[]

  @@index([taskId, createdAt])
  @@index([taskId, status])
}

model TaskDependency {
  id              String             @id @default(cuid())
  workspaceId     String
  taskId          String
  dependsOnTaskId String
  dependencyType  TaskDependencyType
  createdAt       DateTime           @default(now())
  workspace       Workspace          @relation(fields: [workspaceId], references: [id])
  task            Task               @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOnTask   Task               @relation("TaskDependents", fields: [dependsOnTaskId], references: [id])

  @@unique([taskId, dependsOnTaskId])
  @@index([workspaceId, taskId])
  @@index([workspaceId, dependsOnTaskId])
}

model TaskPlan {
  id           String          @id @default(cuid())
  workspaceId  String
  taskId       String
  planId       String          @unique
  revision     Int
  status       TaskPlanStatus
  prompt       String?
  summary      String?
  generatedBy  String?
  compiledPlan Json
  editablePlan Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id])
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  runs         TaskPlanRun[]
  layers       TaskPlanLayer[]

  @@index([workspaceId, taskId, updatedAt])
  @@index([taskId, status, updatedAt])
}

model TaskPlanRun {
  id                  String                @id @default(cuid())
  workspaceId         String
  taskId              String
  planId              String
  planRun             Json
  executionOwnerId    String?
  executionOwnerScope String?
  executionLeaseUntil DateTime?
  executionEpoch      Int                   @default(0)
  latestEventId       String?
  latestRawEventId    String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  workspace           Workspace             @relation(fields: [workspaceId], references: [id])
  task                Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  plan                TaskPlan              @relation(fields: [planId], references: [planId], onDelete: Cascade)
  nodeAttempts        TaskPlanNodeAttempt[]
  providerRuns        TaskPlanProviderRun[]

  @@unique([taskId, planId])
  @@index([taskId, planId, executionOwnerId])
  @@index([executionLeaseUntil])
  @@index([workspaceId, taskId, updatedAt])
}

model TaskPlanNodeAttempt {
  id                         String                @id @default(cuid())
  workspaceId                String
  taskId                     String
  planId                     String
  planRunId                  String
  nodeId                     String
  nodeLayerId                String
  executionContextSnapshotId String?
  idempotencyKey             String                @unique
  attemptNumber              Int
  status                     String
  executionEpoch             Int
  startedAt                  DateTime              @default(now())
  finishedAt                 DateTime?
  error                      Json?
  runtimeSnapshot            Json?
  startedByEventId           String?
  completedByEventId         String?
  failedByEventId            String?
  blockedByEventId           String?
  inputRawEventId            String?
  outputRawEventId           String?
  errorRawEventId            String?
  selectedBranchRef          String?
  selectedNextNodeId         String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  workspace                  Workspace             @relation(fields: [workspaceId], references: [id])
  task                       Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  planRun                    TaskPlanRun           @relation(fields: [planRunId], references: [id], onDelete: Cascade)
  providerRuns               TaskPlanProviderRun[]

  @@index([taskId, planId, nodeId, status])
  @@index([planRunId, nodeId, attemptNumber])
}

model TaskPlanProviderRun {
  id                 String              @id @default(cuid())
  workspaceId        String
  taskId             String
  planId             String
  planRunId          String
  nodeAttemptId      String
  idempotencyKey     String              @unique
  providerRunRef     String?
  runtimeName        String?
  nativeRunId        String?
  firstRawEventId    String?
  lastRawEventId     String?
  completedByEventId String?
  failedByEventId    String?
  correlationId      String?
  status             String
  startedAt          DateTime            @default(now())
  finishedAt         DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id])
  task               Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  planRun            TaskPlanRun         @relation(fields: [planRunId], references: [id], onDelete: Cascade)
  nodeAttempt        TaskPlanNodeAttempt @relation(fields: [nodeAttemptId], references: [id], onDelete: Cascade)

  @@index([taskId, planId, status])
  @@index([nodeAttemptId, status])
}

model TaskPlanLayer {
  id          String    @id @default(cuid())
  workspaceId String
  taskId      String
  planId      String
  layerId     String    @unique
  version     Int
  layer       Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  plan        TaskPlan  @relation(fields: [planId], references: [planId], onDelete: Cascade)

  @@index([taskId, planId, version])
  @@index([workspaceId, taskId, createdAt])
}

model Run {
  id                    String              @id @default(cuid())
  taskId                String
  taskSessionId         String?
  runtimeName           String
  runtimeConfigSnapshot Json?
  runtimeConfigVersion  String?
  runtimeRunRef         String?             @unique
  runtimeSessionRef     String?
  status                RunStatus
  startedAt             DateTime?
  endedAt               DateTime?
  errorSummary          String?
  resumeToken           String?
  triggeredBy           String
  retryable             Boolean             @default(false)
  resumeSupported       Boolean             @default(false)
  pendingInputPrompt    String?
  pendingInputType      String?
  lastSyncedAt          DateTime?
  syncStatus            String              @default("healthy")
  mappingPartial        Boolean             @default(false)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  task                  Task                @relation(fields: [taskId], references: [id])
  taskSession           TaskSession?        @relation(fields: [taskSessionId], references: [id], onDelete: SetNull)
  approvals             Approval[]
  artifacts             Artifact[]
  events                Event[]
  rawEventLogs          RawEventLog[]
  toolInvocations       ToolInvocation[]
  timelineItems         TaskTimelineItem[]
  conversationEntries   ConversationEntry[]
  runtimeCursor         RuntimeCursor?

  @@index([taskId, status])
  @@index([taskSessionId, status])
  @@index([runtimeName, status])
}

model Approval {
  id             String         @id @default(cuid())
  workspaceId    String
  taskId         String
  runId          String
  type           String
  title          String
  summary        String
  riskLevel      String
  payload        Json?
  status         ApprovalStatus
  requestedAt    DateTime
  resolvedAt     DateTime?
  resolvedBy     String?
  resolutionNote String?
  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  task           Task           @relation(fields: [taskId], references: [id])
  run            Run            @relation(fields: [runId], references: [id])

  @@index([workspaceId, status])
  @@index([taskId, status])
  @@index([runId, status])
}

model Artifact {
  id             String       @id @default(cuid())
  workspaceId    String
  taskId         String
  runId          String
  type           ArtifactType
  title          String
  uri            String
  contentPreview String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  workspace      Workspace    @relation(fields: [workspaceId], references: [id])
  task           Task         @relation(fields: [taskId], references: [id])
  run            Run          @relation(fields: [runId], references: [id])

  @@index([workspaceId, type])
  @@index([taskId, createdAt])
  @@index([runId, createdAt])
}

model Memory {
  id          String           @id @default(cuid())
  workspaceId String
  taskId      String?
  sourceRunId String?
  content     String
  scope       MemoryScope
  sourceType  MemorySourceType
  confidence  Float?
  status      MemoryStatus
  expiresAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  workspace   Workspace        @relation(fields: [workspaceId], references: [id])
  task        Task?            @relation(fields: [taskId], references: [id])

  @@index([workspaceId, scope, status])
  @@index([taskId])
}

model Event {
  id                 String             @id @default(cuid())
  eventType          String
  eventVersion       Int                @default(1)
  workspaceId        String
  taskId             String?
  runId              String?
  taskSessionId      String?
  executionSessionId String?
  planId             String?
  planRunId          String?
  nodeAttemptId      String?
  providerRunId      String?
  nodeId             String?
  nodeTitle          String?
  rawEventId         String?
  parentEventId      String?
  causationEventId   String?
  correlationId      String?
  actorType          String
  actorId            String?
  source             String
  payload            Json
  summary            String?
  severity           String?
  dedupeKey          String?            @unique
  occurredAt         DateTime?
  ingestedAt         DateTime           @default(now())
  ingestSequence     Int
  createdAt          DateTime           @default(now())
  workspace          Workspace          @relation(fields: [workspaceId], references: [id])
  task               Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                Run?               @relation(fields: [runId], references: [id], onDelete: Cascade)
  rawEvent           RawEventLog?       @relation(fields: [rawEventId], references: [id], onDelete: SetNull)
  timelineItems      TaskTimelineItem[]

  @@index([taskId, ingestSequence])
  @@index([taskId, nodeId, ingestSequence])
  @@index([runId, ingestSequence])
  @@index([nodeAttemptId, ingestSequence])
  @@index([correlationId, ingestSequence])
  @@index([workspaceId, eventType, ingestSequence])
}

model RawEventLog {
  id                  String             @id @default(cuid())
  workspaceId         String
  taskId              String?
  runId               String?
  taskSessionId       String?
  executionSessionId  String?
  planId              String?
  planRunId           String?
  nodeAttemptId       String?
  providerRunId       String?
  nodeId              String?
  nodeTitle           String?
  source              String
  direction           String
  rawType             String
  provider            String?
  runtimeName         String?
  rawPayload          Json?
  rawText             String?
  metadata            Json?
  nativeRunId         String?
  nativeEventId       String?
  nativeToolCallId    String?
  externalRef         String?
  sequence            Int?
  correlationId       String?
  parentRawEventId    String?
  causationRawEventId String?
  payloadHash         String
  redactionState      String             @default("none")
  redactionMetadata   Json?
  occurredAt          DateTime?
  receivedAt          DateTime           @default(now())
  createdAt           DateTime           @default(now())
  workspace           Workspace          @relation(fields: [workspaceId], references: [id])
  task                Task?              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                 Run?               @relation(fields: [runId], references: [id], onDelete: Cascade)
  events              Event[]
  timelineItems       TaskTimelineItem[]

  @@unique([source, externalRef])
  @@index([taskId, receivedAt])
  @@index([runId, sequence])
  @@index([nodeAttemptId, receivedAt])
  @@index([correlationId, receivedAt])
  @@index([nativeToolCallId])
  @@index([workspaceId, source, receivedAt])
}

model ConversationEntry {
  id          String    @id @default(cuid())
  runId       String
  role        String
  content     String
  runtimeTs   DateTime?
  sequence    Int
  externalRef String?   @unique
  createdAt   DateTime  @default(now())
  run         Run       @relation(fields: [runId], references: [id])

  @@index([runId, sequence])
}

model ToolInvocation {
  id                 String    @id @default(cuid())
  workspaceId        String
  taskId             String?
  runId              String?
  executionSessionId String?
  planId             String?
  planRunId          String?
  nodeAttemptId      String?
  providerRunId      String?
  nodeId             String?
  toolName           String
  toolKind           String?
  status             String
  inputRawEventId    String?
  outputRawEventId   String?
  errorRawEventId    String?
  canonicalEventId   String?
  inputPayload       Json?
  outputPayload      Json?
  errorPayload       Json?
  inputSummary       String?
  outputSummary      String?
  errorSummary       String?
  nativeToolCallId   String?
  externalRef        String?
  correlationId      String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  workspace          Workspace @relation(fields: [workspaceId], references: [id])
  task               Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                Run?      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, nativeToolCallId])
  @@index([taskId, createdAt])
  @@index([runId, createdAt])
  @@index([nodeAttemptId, createdAt])
  @@index([toolName, status])
  @@index([correlationId])
}

model TaskTimelineItem {
  id                 String       @id @default(cuid())
  workspaceId        String
  taskId             String
  runId              String?
  executionSessionId String?
  nodeId             String?
  nodeAttemptId      String?
  kind               String
  title              String
  body               String?
  severity           String?
  status             String?
  eventId            String?
  rawEventId         String?
  toolInvocationId   String?
  sortTime           DateTime
  metadata           Json?
  createdAt          DateTime     @default(now())
  workspace          Workspace    @relation(fields: [workspaceId], references: [id])
  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run                Run?         @relation(fields: [runId], references: [id], onDelete: Cascade)
  event              Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  rawEvent           RawEventLog? @relation(fields: [rawEventId], references: [id], onDelete: SetNull)

  @@index([taskId, sortTime])
  @@index([taskId, nodeId, sortTime])
  @@index([runId, sortTime])
  @@index([eventId])
}

model TaskProjection {
  taskId                String    @id
  workspaceId           String
  persistedStatus       String
  displayState          String?
  blockType             String?
  blockScope            String?
  blockSince            DateTime?
  actionRequired        String?
  latestRunStatus       String?
  approvalPendingCount  Int       @default(0)
  dueAt                 DateTime?
  scheduledStartAt      DateTime?
  scheduledEndAt        DateTime?
  scheduleStatus        String?
  scheduleSource        String?
  scheduleProposalCount Int       @default(0)
  latestArtifactTitle   String?
  lastActivityAt        DateTime?
  latestEventId         String?
  latestRawEventId      String?
  blockedByEventId      String?
  blockedByRawEventId   String?
  currentNodeId         String?
  currentNodeTitle      String?
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id])
  task                  Task      @relation(fields: [taskId], references: [id])

  @@index([workspaceId, persistedStatus])
  @@index([workspaceId, displayState])
}

model ScheduleProposal {
  id               String                 @id @default(cuid())
  workspaceId      String
  taskId           String
  source           ScheduleSource
  status           ScheduleProposalStatus @default(Pending)
  proposedBy       String
  summary          String
  dueAt            DateTime?
  scheduledStartAt DateTime?
  scheduledEndAt   DateTime?
  createdAt        DateTime               @default(now())
  resolvedAt       DateTime?
  resolutionNote   String?
  workspace        Workspace              @relation(fields: [workspaceId], references: [id])
  task             Task                   @relation(fields: [taskId], references: [id])

  @@index([workspaceId, status])
  @@index([taskId, status])
}

model RuntimeCursor {
  runId        String    @id
  runtimeName  String
  nextCursor   String?
  lastEventRef String?
  lastSyncedAt DateTime?
  healthStatus String    @default("healthy")
  lastError    String?
  run          Run       @relation(fields: [runId], references: [id])
}

// ────────────────────────────────────────────────────────────────────
// AI Client Configuration
// ────────────────────────────────────────────────────────────────────

// ────────────────────────────────────────────────────────────────────
// Execution Layer Enums
// ────────────────────────────────────────────────────────────────────

enum WorkBlockStatus {
  Scheduled
  Active
  Completed
  Cancelled
}

enum WorkBlockTrigger {
  scheduled
  manual
}

enum ExecutionSessionStatus {
  Active
  Paused
  Completed
  Abandoned
}

model AiClient {
  id        String             @id @default(cuid())
  name      String
  type      String
  /// JSON config — shape depends on type:
  ///   llm: { baseUrl, apiKey, model, temperature }
  ///   hermes: { baseUrl, apiKey, timeoutMs }
  ///   provider: { baseUrl, apiKey, model, timeoutMs }
  config    Json
  isDefault Boolean            @default(false)
  enabled   Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  bindings  AiFeatureBinding[]
}

model AiFeatureBinding {
  id        String   @id @default(cuid())
  feature   String /// e.g. "suggest", "decompose", "conflicts", "timeslots", "chat"
  clientId  String
  client    AiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([feature])
}

// ────────────────────────────────────────────────────────────────────
// Task Workspace Assistant Messages
// ────────────────────────────────────────────────────────────────────

model TaskAssistantMessage {
  id        String    @id @default(cuid())
  taskId    String
  role      String /// "user" | "assistant"
  content   String
  proposal  Json? /// TaskWorkspaceUpdateProposal
  applied   Boolean   @default(false)
  appliedAt DateTime?
  sequence  Int
  createdAt DateTime  @default(now())
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, sequence])
}

// ────────────────────────────────────────────────────────────────────
// Execution Layer Models
// ────────────────────────────────────────────────────────────────────

model WorkBlock {
  id                String             @id @default(cuid())
  workspaceId       String
  taskId            String
  planId            String?
  title             String
  status            WorkBlockStatus    @default(Scheduled)
  scheduledStartAt  DateTime
  scheduledEndAt    DateTime
  startedAt         DateTime?
  completedAt       DateTime?
  trigger           WorkBlockTrigger   @default(scheduled)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  workspace         Workspace          @relation(fields: [workspaceId], references: [id])
  task              Task               @relation(fields: [taskId], references: [id], onDelete: Cascade)
  executionSessions ExecutionSession[]

  @@index([workspaceId, status])
  @@index([taskId, status])
  @@index([workspaceId, scheduledStartAt])
}

model ExecutionSession {
  id                   String                 @id @default(cuid())
  workspaceId          String
  taskId               String
  workBlockId          String?
  planId               String?
  status               ExecutionSessionStatus @default(Active)
  currentNodeId        String?
  currentNodeAttemptId String?
  pauseReason          String?
  completedNodeIds     String                 @default("[]") /// JSON array of completed node IDs
  pausedByEventId      String?
  pausedByRawEventId   String?
  latestEventId        String?
  latestRawEventId     String?
  startedAt            DateTime               @default(now())
  pausedAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  workspace            Workspace              @relation(fields: [workspaceId], references: [id])
  task                 Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workBlock            WorkBlock?             @relation(fields: [workBlockId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([taskId, status])
  @@index([workBlockId])
}
