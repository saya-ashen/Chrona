generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "../packages/db/src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum WorkspaceStatus {
  Active
  Archived
}

enum GoalStatus {
  Draft
  Active
  Paused
  Achieved
  Stopped
}

enum GoalAssetRole {
  working_document
  reference
  evidence
  submission
  template
}

enum GoalAssetStatus {
  Draft
  NeedsReview
  Approved
  Superseded
  Archived
}


enum GoalAssetOwnershipProposalStatus {
  Generating
  Ready
  Applied
  Rejected
  Stale
  Failed
}

enum GoalAssetOwnershipDecision {
  create_asset
  append_version
  separate_asset
}

enum GoalAssetReviewAuthorType {
  user
  task_result
}

enum GoalAssetKind {
  document
  form
  page
  file
  data_table
  structured_result
}

enum GoalAssetVersionSource {
  manual
  ai_task
  inbox
  restored
  imported
}

enum GoalAssetDraftStatus {
  Active
  Conflict
  Discarded
  Submitted
}

enum GoalInboxCandidateStatus {
  Pending
  Accepted
  Rejected
}

enum GoalAssetJobKind {
  thumbnail
  export
}

enum GoalAssetJobStatus {
  Queued
  Processing
  Completed
  Failed
}

enum GoalReviewProposalStatus {
  Generating
  Ready
  PartiallyApplied
  Applied
  Rejected
  Superseded
  Failed
}

enum GoalReviewItemKind {
  brief_field
  next_review_at
  task_candidate
  evidence_gap
}

enum GoalReviewItemDecision {
  Pending
  Accepted
  Rejected
  Converted
  Ignored
  Stale
}

enum TaskDefinitionStatus {
  Draft
  Active
  Paused
  Completed
  Stopped
}

enum TaskOccurrenceStatus {
  Scheduled
  Ready
  Running
  WaitingForInput
  WaitingForApproval
  Blocked
  Failed
  Completed
  Cancelled
  Ignored
}

enum TaskTriggerState {
  Enabled
  Paused
  Retired
}

enum TriggerDeliveryStatus {
  Received
  Accepted
  Ignored
  Duplicate
  Failed
}

enum TaskStatus {
  Draft
  Ready
  Queued
  Running
  WaitingForInput
  WaitingForApproval
  Scheduled
  Blocked
  Failed
  Completed
  Done
  Cancelled
}

enum TaskPriority {
  Low
  Medium
  High
  Urgent
}

enum TaskKind {
  single
  recurring
}

enum ScheduleStatus {
  Unscheduled
  Scheduled
  InProgress
  AtRisk
  Interrupted
  Overdue
  Completed
}

enum ScheduleSource {
  human
  ai
  system
}

enum ScheduleProposalStatus {
  Pending
  Accepted
  Rejected
}

enum CalendarSourceLifecycleState {
  active
  disabled
  removing
  removed
}

enum CalendarEventStatus {
  confirmed
  tentative
  cancelled
}

enum CalendarSyncState {
  idle
  syncing
  success
  partial
  failed
}

enum CalendarSyncPolicy {
  keep_active
  auto_complete_past_events
}

enum CalendarAutomationPolicy {
  manual
  auto_plan
  auto_execute
}

enum RunStatus {
  Pending
  Running
  WaitingForInput
  WaitingForApproval
  Failed
  Completed
  Cancelled
}

enum ApprovalStatus {
  Pending
  Approved
  Rejected
  EditedAndApproved
  Expired
}

enum ArtifactType {
  file
  patch
  summary
  report
  terminal_output
  url
}

enum MemoryScope {
  user
  workspace
  project
  task
}

enum MemorySourceType {
  user_input
  agent_inferred
  imported
  system_rule
  plan_layer
}

enum MemoryStatus {
  Active
  Inactive
  Conflicted
  Expired
}

enum TaskPlanStatus {
  Draft
  Accepted
  Superseded
  Archived
}

enum TaskDependencyType {
  blocks
  relates_to
  child_of
}

model Workspace {
  id                        String                     @id @default(cuid())
  name                      String
  description               String?
  defaultRuntime            String
  status                    WorkspaceStatus
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  goals                     Goal[]
  goalAssets                GoalAsset[]
  tasks                     Task[]
  approvals                 Approval[]
  artifacts                 Artifact[]
  memories                  Memory[]
  events                    Event[]
  rawEventLogs              RawEventLog[]
  goalReviewProposals       GoalReviewProposal[]
  goalReviewItems           GoalReviewProposalItem[]
  toolInvocations           ToolInvocation[]
  agentToolMutations      AgentToolMutation[]
  taskTimelineItems         TaskTimelineItem[]
  taskDependencies          TaskDependency[]
  taskProjections           TaskProjection[]
  scheduleProposals         ScheduleProposal[]
  workBlocks                WorkBlock[]
  executionSessions         ExecutionSession[]
  taskPlans                 TaskPlan[]
  taskPlanRuns              TaskPlanRun[]
  taskPlanNodeAttempts      TaskPlanNodeAttempt[]
  taskPlanProviderRuns      TaskPlanProviderRun[]
  taskPlanProviderApprovals TaskPlanProviderApproval[]
  taskPlanLayers            TaskPlanLayer[]
  graphVersions             GraphVersion[]
  graphMutations            GraphMutationRecord[]
  reconciliationEvents      ReconciliationEvent[]
  schedulerEvents           SchedulerEvent[]
  calendarSources           CalendarSource[]
  importedCalendarEvents    ImportedCalendarEvent[]
  runTokens                 RunToken[]
  taskPlanTerminalActions   TaskPlanTerminalAction[]
  aiSurfaces                WorkspaceAiSurface[]
  userPreferences           WorkspaceUserPreference[]
  goalBriefRevisions        GoalBriefRevision[]
  goalAssetVersions         GoalAssetVersion[]
  goalAssetDrafts           GoalAssetDraft[]
  goalInboxCandidates       GoalInboxCandidate[]
  goalFormSubmissions       GoalFormSubmission[]
  goalAssetJobs             GoalAssetJob[]
  goalAssetReviews          GoalAssetReview[]
  assetOwnershipProposals    GoalAssetOwnershipProposal[]
  taskOccurrences           TaskOccurrence[]
  taskTriggers              TaskTrigger[]
  triggerDeliveries         TriggerDelivery[]
}

model CalendarSource {
  id                        String                       @id @default(cuid())
  workspaceId               String
  name                      String
  sourceType                String                       @default("subscription")
  sourceUrl                 String
  redactedUrlLabel          String
  color                     String
  lifecycleState            CalendarSourceLifecycleState @default(active)
  syncPolicy                CalendarSyncPolicy           @default(keep_active)
  automationPolicy          CalendarAutomationPolicy     @default(auto_plan)
  syncState                 CalendarSyncState            @default(idle)
  lastSuccessfulRefreshAt   DateTime?
  nextExpectedRefreshAt     DateTime?
  lastErrorCode             String?
  lastErrorMessage          String?
  blockedNetworkConfirmedAt DateTime?
  importedCount             Int                          @default(0)
  skippedCount              Int                          @default(0)
  createdAt                 DateTime                     @default(now())
  updatedAt                 DateTime                     @updatedAt
  workspace                 Workspace                    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  events                    ImportedCalendarEvent[]

  @@unique([workspaceId, sourceUrl])
  @@index([workspaceId, lifecycleState])
}

model ImportedCalendarEvent {
  id               String              @id @default(cuid())
  workspaceId      String
  calendarSourceId String
  taskId           String?
  workBlockId      String?             @unique
  externalUid      String
  recurrenceId     String?
  recurrenceRule   String?
  dedupeKey        String
  title            String
  description      String?
  startsAt         DateTime
  endsAt           DateTime
  isAllDay         Boolean             @default(false)
  status           CalendarEventStatus @default(confirmed)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  calendarSource   CalendarSource      @relation(fields: [calendarSourceId], references: [id], onDelete: Cascade)
  task             Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  workBlock        WorkBlock?          @relation(fields: [workBlockId], references: [id], onDelete: SetNull)

  @@unique([calendarSourceId, dedupeKey])
  @@index([taskId])
  @@index([workspaceId, startsAt, endsAt])
  @@index([calendarSourceId, startsAt])
}

model Goal {
  id                      String               @id @default(cuid())
  workspaceId             String
  title                   String
  titleSource             String               @default("user")
  titleRenameNoticeSeenAt DateTime?
  description             String?
  successCriteria         Json
  status                  GoalStatus           @default(Draft)
  nextReviewAt            DateTime?
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @updatedAt
  achievedAt              DateTime?
  stoppedAt               DateTime?
  achievementConfirmation Json?
  operationalBrief        Json?
  workspace               Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks                   Task[]
  assets                  GoalAsset[]
  inboxCandidates         GoalInboxCandidate[]
  formSubmissions         GoalFormSubmission[]
  assetJobs               GoalAssetJob[]
  assetOwnershipProposals GoalAssetOwnershipProposal[]
  briefRevisions          GoalBriefRevision[]
  goalAssetVersions       GoalAssetVersion[]
  goalAssetDrafts         GoalAssetDraft[]
  goalAssetReviews        GoalAssetReview[]
  reviewProposals         GoalReviewProposal[]
  reviewProposalItems     GoalReviewProposalItem[]

  @@index([workspaceId, status])
  @@index([workspaceId, updatedAt])
}

model GoalAsset {
  id                String               @id @default(cuid())
  workspaceId       String
  goalId            String
  sourceArtifactId  String
  currentArtifactId String
  role              GoalAssetRole
  status            GoalAssetStatus
  label             String
  description       String?
  kind              GoalAssetKind        @default(file)
  archivedAt        DateTime?
  lastOpenedAt      DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal              Goal                 @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sourceArtifact    Artifact             @relation("GoalAssetSourceArtifact", fields: [sourceArtifactId], references: [id])
  currentArtifact   Artifact             @relation("GoalAssetCurrentArtifact", fields: [currentArtifactId], references: [id])
  versions          GoalAssetVersion[]
  drafts            GoalAssetDraft[]
  inboxTargets      GoalInboxCandidate[] @relation("GoalInboxTargetAsset")
  submissions       GoalFormSubmission[]
  jobs              GoalAssetJob[]
  reviews           GoalAssetReview[]
  ownershipProposalTargets GoalAssetOwnershipProposal[]
  ownershipProposalFinalAssets GoalAssetOwnershipProposal[] @relation("GoalAssetOwnershipFinalAsset")

  @@unique([goalId, sourceArtifactId])
  @@index([workspaceId, goalId])
  @@index([sourceArtifactId])
  @@index([currentArtifactId])
  @@index([goalId, archivedAt, updatedAt])
}


model GoalBriefRevision {
  id          String    @id @default(cuid())
  workspaceId String
  goalId      String
  brief       Json
  actorType   String
  actorId     String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, createdAt])
  @@index([workspaceId, goalId])
}

model GoalReviewProposal {
  id                  String                   @id @default(cuid())
  workspaceId         String
  goalId              String
  sourceTaskId        String?                  @unique
  sourceRunId         String?                  @unique
  status              GoalReviewProposalStatus @default(Generating)
  inputSnapshot       Json
  inputSnapshotHash   String
  schemaVersion       Int                      @default(1)
  providerName        String?
  modelName           String?
  summary             String?
  rawResult           Json?
  generationError     String?
  requestIdempotencyKey String
  applicationIdempotencyKey String?
  appliedAt           DateTime?
  rejectedAt          DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  workspace           Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal                Goal                     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sourceTask          Task?                    @relation("GoalReviewSourceTask", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  sourceRun           Run?                     @relation("GoalReviewSourceRun", fields: [sourceRunId], references: [id], onDelete: SetNull)
  items               GoalReviewProposalItem[]

  @@unique([goalId, requestIdempotencyKey])
  @@index([workspaceId, goalId, status])
  @@index([goalId, createdAt])
}

model GoalReviewProposalItem {
  id                 String                         @id @default(cuid())
  workspaceId        String
  goalId             String
  proposalId         String
  itemId             String
  kind               GoalReviewItemKind
  payload            Json
  rationale          String
  evidenceRefs       Json
  warnings           Json
  dependencySnapshot Json
  dependencyHash     String
  decision           GoalReviewItemDecision         @default(Pending)
  decisionReason     String?
  appliedObjectType  String?
  appliedObjectId    String?
  decidedAt          DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  workspace          Workspace                      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal               Goal                           @relation(fields: [goalId], references: [id], onDelete: Cascade)
  proposal           GoalReviewProposal             @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@unique([proposalId, itemId])
  @@index([workspaceId, goalId, decision])
  @@index([proposalId, kind])
}


model Task {
  id                        String                     @id @default(cuid())
  workspaceId               String
  goalId                    String?
  title                     String
  description               String?
  kind                      TaskKind                   @default(single)
  recurrenceRule            String?
  seriesExternalUid         String?
  recurrenceAnchorStartAt   DateTime?
  recurrenceAnchorEndAt     DateTime?
  recurrenceWindowUntil     DateTime?
  executionRuntime          String
  executionConfig           Json
  pinnedModel                String?
  pinnedModelSource          String?
  status                    TaskStatus
  priority                  TaskPriority
  autoPlanGeneration        Boolean                    @default(false)
  autoExecute               Boolean                    @default(false)
  autoPlanGenerationTiming  String                     @default("at_start")
  autoExecuteTiming         String                     @default("at_start")
  parentTaskId              String?
  dueAt                     DateTime?
  blockReason               Json?
  goalContext               Json?
  definitionStatus          TaskDefinitionStatus       @default(Active)
  defaultSessionId          String?
  aiClientId                String?
  latestRunId               String?
  latestEventId             String?
  latestRawEventId          String?
  blockedByEventId          String?
  blockedByRawEventId       String?
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  completedAt               DateTime?
  goal                      Goal?                      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  workspace                 Workspace                  @relation(fields: [workspaceId], references: [id])
  runs                      Run[]
  sessions                  TaskSession[]              @relation("TaskSessions")
  approvals                 Approval[]
  artifacts                 Artifact[]
  memories                  Memory[]
  events                    Event[]
  rawEventLogs              RawEventLog[]
  toolInvocations           ToolInvocation[]
  occurrences               TaskOccurrence[]
  triggers                  TaskTrigger[]
  triggerDeliveries         TriggerDelivery[]
  assetVersions             GoalAssetVersion[]
  goalReviewSourceProposal GoalReviewProposal?        @relation("GoalReviewSourceTask")
  inboxCandidates           GoalInboxCandidate[]
  formSubmissions           GoalFormSubmission[]
  assetJobs                 GoalAssetJob[]
  assetReviews             GoalAssetReview[]
  timelineItems             TaskTimelineItem[]
  projection                TaskProjection?
  dependencies              TaskDependency[]           @relation("TaskDependencies")
  dependentTasks            TaskDependency[]           @relation("TaskDependents")
  scheduleProposals         ScheduleProposal[]
  assistantMessages         TaskAssistantMessage[]
  resultContinuations       TaskResultContinuation[]
  workBlocks                WorkBlock[]
  executionSessions         ExecutionSession[]
  taskPlans                 TaskPlan[]
  taskPlanRuns              TaskPlanRun[]
  taskPlanNodeAttempts      TaskPlanNodeAttempt[]
  taskPlanProviderRuns      TaskPlanProviderRun[]
  taskPlanProviderApprovals TaskPlanProviderApproval[]
  taskPlanLayers            TaskPlanLayer[]
  graphVersions             GraphVersion[]
  graphMutations            GraphMutationRecord[]
  reconciliationEvents      ReconciliationEvent[]
  aiClient                  AiClient?                  @relation(fields: [aiClientId], references: [id], onDelete: SetNull)
  schedulerEvents           SchedulerEvent[]
  importedCalendarEvents    ImportedCalendarEvent[]
  runTokens                 RunToken[]
  taskPlanTerminalActions   TaskPlanTerminalAction[]
  assetOwnershipProposals GoalAssetOwnershipProposal[]
  agentToolMutations      AgentToolMutation[]

  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, seriesExternalUid])
  @@index([defaultSessionId])
  @@index([goalId])
  @@index([workspaceId, definitionStatus])
  @@index([aiClientId])
}

enum GraphMutationStatus {
  Pending
  Applied
  Rejected
  Cancelled
}

model SchedulerLease {
  name        String   @id
  ownerId     String
  expiresAt   DateTime
  heartbeatAt DateTime
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([expiresAt])
}

model GraphVersion {
  id          String    @id @default(cuid())
  workspaceId String
  taskId      String
  version     Int
  graph       Json
  createdBy   String
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, version])
  @@index([workspaceId, taskId, version])
}

model GraphMutationRecord {
  id               String              @id @default(cuid())
  workspaceId      String
  taskId           String
  baseGraphVersion Int
  operation        String
  status           GraphMutationStatus @default(Pending)
  payload          Json
  validationResult Json?
  affectedNodeIds  Json?
  createdBy        String
  createdAt        DateTime            @default(now())
  appliedAt        DateTime?
  workspace        Workspace           @relation(fields: [workspaceId], references: [id])
  task             Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status, createdAt])
  @@index([taskId, baseGraphVersion, status])
}

model ReconciliationEvent {
  id             String    @id @default(cuid())
  workspaceId    String
  taskId         String
  graphVersion   Int
  executionState String
  currentNodeId  String?
  issues         Json?
  repairActions  Json?
  createdAt      DateTime  @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id])
  task           Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([taskId, graphVersion, createdAt])
}

model SchedulerEvent {
  id           String    @id @default(cuid())
  workspaceId  String
  taskId       String
  graphVersion Int?
  eventType    String
  reason       String?
  payload      Json?
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id])
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventType, createdAt])
  @@index([taskId, createdAt])
}

model TaskSession {
  id                 String     @id @default(cuid())
  taskId             String
  runtimeName        String
  sessionKey         String     @unique
  label              String?
  status             String     @default("idle")
  lastRunStatus      String?
  activeRunId        String?
  lastRunRef         String?
  providerSessionRef String?
  capabilityScope    String     @default("unknown")
  allowedToolNames   String     @default("[]") /// JSON array; empty denies all mutations.
  createdByFramework Boolean    @default(true)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  task               Task       @relation("TaskSessions", fields: [taskId], references: [id], onDelete: Cascade)
  runs               Run[]
  agentToolMutations      AgentToolMutation[]
  workBlock          WorkBlock? @relation("WorkBlockSession")

  @@index([taskId, createdAt])
  @@index([taskId, status])
}

model TaskDependency {
  id              String             @id @default(cuid())
  workspaceId     String
  taskId          String
  dependsOnTaskId String
  dependencyType  TaskDependencyType
  createdAt       DateTime           @default(now())
  workspace       Workspace          @relation(fields: [workspaceId], references: [id])
  task            Task               @relation("TaskDependencies", fields: [taskId], references: [id])
  dependsOnTask   Task               @relation("TaskDependents", fields: [dependsOnTaskId], references: [id])

  @@unique([taskId, dependsOnTaskId])
  @@index([workspaceId, taskId])
  @@index([workspaceId, dependsOnTaskId])
}

model TaskPlan {
  id           String          @id @default(cuid())
  workspaceId  String
  taskId       String
  workBlockId  String?
  occurrenceId String?
  planId       String          @unique
  revision     Int
  status       TaskPlanStatus
  prompt       String?
  summary      String?
  generatedBy  String?
  compiledPlan Json
  editablePlan Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  workspace    Workspace       @relation(fields: [workspaceId], references: [id])
  task         Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workBlock    WorkBlock?      @relation(fields: [workBlockId], references: [id], onDelete: SetNull)
  occurrence   TaskOccurrence? @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  runs         TaskPlanRun[]
  layers       TaskPlanLayer[]

  @@index([workspaceId, taskId, updatedAt])
  @@index([taskId, workBlockId, status, updatedAt])
  @@index([occurrenceId, status, updatedAt])
  @@index([workBlockId, status, updatedAt])
}

model TaskPlanRun {
  id                  String                     @id @default(cuid())
  workspaceId         String
  taskId              String
  workBlockId         String?
  workBlockScopeKey   String                     @default("")
  occurrenceId        String?
  planId              String
  planRun             Json
  executionOwnerId    String?
  executionOwnerScope String?
  executionLeaseUntil DateTime?
  executionEpoch      Int                        @default(0)
  executionCommandKey String?
  latestEventId       String?
  latestRawEventId    String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  workspace           Workspace                  @relation(fields: [workspaceId], references: [id])
  task                Task                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workBlock           WorkBlock?                 @relation(fields: [workBlockId], references: [id], onDelete: SetNull)
  plan                TaskPlan                   @relation(fields: [planId], references: [planId], onDelete: Cascade)
  nodeAttempts        TaskPlanNodeAttempt[]
  occurrence          TaskOccurrence?            @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  providerRuns        TaskPlanProviderRun[]
  providerApprovals   TaskPlanProviderApproval[]

  @@unique([taskId, planId, workBlockScopeKey])
  @@index([taskId, planId, executionOwnerId])
  @@index([taskId, workBlockId, planId])
  @@index([taskId, planId, workBlockScopeKey])
  @@index([executionLeaseUntil])
  @@index([workspaceId, taskId, updatedAt])
  @@index([occurrenceId, updatedAt])
}

model TaskPlanNodeAttempt {
  id                         String                     @id @default(cuid())
  workspaceId                String
  taskId                     String
  planId                     String
  planRunId                  String
  nodeId                     String
  nodeLayerId                String
  executionContextSnapshotId String?
  idempotencyKey             String                     @unique
  attemptNumber              Int
  status                     String
  executionEpoch             Int
  startedAt                  DateTime                   @default(now())
  finishedAt                 DateTime?
  error                      Json?
  runtimeSnapshot            Json?
  startedByEventId           String?
  completedByEventId         String?
  failedByEventId            String?
  blockedByEventId           String?
  inputRawEventId            String?
  outputRawEventId           String?
  errorRawEventId            String?
  selectedBranchRef          String?
  selectedNextNodeId         String?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  workspace                  Workspace                  @relation(fields: [workspaceId], references: [id])
  task                       Task                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  planRun                    TaskPlanRun                @relation(fields: [planRunId], references: [id], onDelete: Cascade)
  providerRuns               TaskPlanProviderRun[]
  providerApprovals          TaskPlanProviderApproval[]
  terminalActions            TaskPlanTerminalAction[]

  @@index([taskId, planId, nodeId, status])
  @@index([planRunId, nodeId, attemptNumber])
}

model TaskPlanProviderRun {
  id                 String                     @id @default(cuid())
  workspaceId        String
  taskId             String
  planId             String
  planRunId          String
  nodeAttemptId      String
  idempotencyKey     String                     @unique
  providerRunRef     String?
  runtimeName        String?
  nativeRunId        String?
  firstRawEventId    String?
  lastRawEventId     String?
  completedByEventId String?
  failedByEventId    String?
  correlationId      String?
  status             String
  startedAt          DateTime                   @default(now())
  finishedAt         DateTime?
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  workspace          Workspace                  @relation(fields: [workspaceId], references: [id])
  task               Task                       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  planRun            TaskPlanRun                @relation(fields: [planRunId], references: [id], onDelete: Cascade)
