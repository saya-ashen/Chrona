  model                 String?
  generationError       String?
  finalAction            String?
  finalAssetId           String?
  createdAt             DateTime                          @default(now())
  updatedAt             DateTime                          @updatedAt
  readyAt               DateTime?
  appliedAt             DateTime?
  rejectedAt            DateTime?

  workspace      Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal           Goal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  inboxCandidate GoalInboxCandidate @relation(fields: [inboxCandidateId], references: [id], onDelete: Cascade)
  sourceTask     Task?              @relation(fields: [sourceTaskId], references: [id], onDelete: SetNull)
  sourceRun      Run?               @relation("GoalAssetOwnershipSourceRun", fields: [sourceRunId], references: [id], onDelete: SetNull)
  targetAsset    GoalAsset?         @relation(fields: [targetAssetId], references: [id], onDelete: SetNull)
  finalAsset     GoalAsset?         @relation("GoalAssetOwnershipFinalAsset", fields: [finalAssetId], references: [id], onDelete: SetNull)

  @@unique([inboxCandidateId, requestIdempotencyKey])
  @@index([workspaceId, status, updatedAt])
  @@index([goalId, updatedAt])
  @@index([inboxCandidateId, createdAt])
}

model GoalFormSubmission {
  id          String           @id @default(cuid())
  workspaceId String
  goalId      String
  assetId     String
  versionId   String
  taskId      String?
  content     Json
  contentHash String
  createdAt   DateTime         @default(now())
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal        Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  asset       GoalAsset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version     GoalAssetVersion @relation(fields: [versionId], references: [id])
  task        Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([assetId, createdAt])
  @@index([goalId, createdAt])
}

model GoalAssetJob {
  id           String             @id @default(cuid())
  workspaceId  String
  goalId       String
  assetId      String
  versionId    String
  taskId       String?
  kind         GoalAssetJobKind
  format       String?
  status       GoalAssetJobStatus @default(Queued)
  outputUri    String?
  errorCode    String?
  errorMessage String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  goal         Goal               @relation(fields: [goalId], references: [id], onDelete: Cascade)
  asset        GoalAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  version      GoalAssetVersion   @relation(fields: [versionId], references: [id])
  task         Task?              @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([assetId, kind, createdAt])
  @@index([goalId, status])
}

model TaskTrigger {
  id          String            @id @default(cuid())
  workspaceId String
  taskId      String
  kind        String
  state       TaskTriggerState  @default(Enabled)
  config      Json
  version     Int               @default(1)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task        Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  deliveries  TriggerDelivery[]
  occurrences TaskOccurrence[]

  @@unique([taskId, kind])
  @@index([workspaceId, state])
}

model TriggerDelivery {
  id              String                @id @default(cuid())
  workspaceId     String
  triggerId       String
  taskId          String
  deliveryKey     String
  status          TriggerDeliveryStatus @default(Received)
  receivedAt      DateTime              @default(now())
  processedAt     DateTime?
  payloadDigest   String?
  normalizedInput Json?
  ignoreReason    String?
  errorCode       String?
  workspace       Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  trigger         TaskTrigger           @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  task            Task                  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  occurrence      TaskOccurrence?

  @@unique([triggerId, deliveryKey])
  @@index([workspaceId, status, receivedAt])
}

model TaskOccurrence {
  id                String               @id @default(cuid())
  workspaceId       String
  taskId            String
  deliveryId        String?              @unique
  triggerId         String?
  workBlockId       String?              @unique
  occurrenceKey     String
  triggerVersion    Int?
  source            Json
  status            TaskOccurrenceStatus
  eligibleAt        DateTime
  materializedAt    DateTime             @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  normalizedInput   Json?
  executionEpoch    Int                  @default(1)
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task              Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  trigger           TaskTrigger?         @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  delivery          TriggerDelivery?     @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  workBlock         WorkBlock?           @relation(fields: [workBlockId], references: [id], onDelete: SetNull)
  taskPlans         TaskPlan[]
  taskPlanRuns      TaskPlanRun[]
  executionSessions ExecutionSession[]
  runs              Run[]
  artifacts         Artifact[]

  @@unique([taskId, occurrenceKey])
  @@index([workspaceId, status, eligibleAt])
  @@index([taskId, status, eligibleAt])
}

// ────────────────────────────────────────────────────────────────────
// Execution Layer Models
// ────────────────────────────────────────────────────────────────────

model WorkBlock {
  id                    String                 @id @default(cuid())
  workspaceId           String
  taskId                String
  sessionId             String?                @unique
  planId                String?
  recurrenceKey         String?
  title                 String
  status                WorkBlockStatus        @default(Scheduled)
  scheduledStartAt      DateTime
  scheduledEndAt        DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  trigger               WorkBlockTrigger       @default(scheduled)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  workspace             Workspace              @relation(fields: [workspaceId], references: [id])
  task                  Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  session               TaskSession?           @relation("WorkBlockSession", fields: [sessionId], references: [id], onDelete: SetNull)
  taskPlans             TaskPlan[]
  taskPlanRuns          TaskPlanRun[]
  executionSessions     ExecutionSession[]
  runs                  Run[]
  importedCalendarEvent ImportedCalendarEvent?
  occurrence            TaskOccurrence?
  events                Event[]
  timelineItems         TaskTimelineItem[]

  @@unique([taskId, recurrenceKey])
  @@index([workspaceId, status])
  @@index([taskId, status])
  @@index([sessionId])
  @@index([workspaceId, scheduledStartAt])
}

model ExecutionSession {
  id                   String                 @id @default(cuid())
  workspaceId          String
  taskId               String
  workBlockId          String?
  planId               String?
  status               ExecutionSessionStatus @default(Active)
  currentNodeId        String?
  currentNodeAttemptId String?
  pauseReason          String?
  completedNodeIds     String                 @default("[]") /// JSON array of completed node IDs
  pausedByEventId      String?
  pausedByRawEventId   String?
  latestEventId        String?
  latestRawEventId     String?
  startedAt            DateTime               @default(now())
  pausedAt             DateTime?
  completedAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  workspace            Workspace              @relation(fields: [workspaceId], references: [id])
  task                 Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  workBlock            WorkBlock?             @relation(fields: [workBlockId], references: [id], onDelete: SetNull)
  occurrenceId         String?
  occurrence           TaskOccurrence?        @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  activeScopeKey       String?

  @@index([workspaceId, status])
  @@index([taskId, status])
  @@index([workBlockId])
  @@unique([taskId, activeScopeKey])
  @@index([occurrenceId])
}

model RunToken {
  id                String    @id @default(cuid())
  tokenHash         String    @unique
  taskId            String
  taskSessionId     String?
  runId             String
  runtimeSessionKey String
  nodeId            String?
  nodeAttemptId     String?
  expiresAt         DateTime
  revokedAt         DateTime?
  createdAt         DateTime  @default(now())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task              Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run               Run       @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([taskId, nodeAttemptId])
  @@index([runId])
  @@index([expiresAt])
}

model TaskPlanTerminalAction {
  id                String               @id @default(cuid())
  workspaceId       String
  taskId            String
  runId             String
  taskSessionId     String?
  runtimeSessionKey String
  nodeId            String?
  nodeAttemptId     String?
  kind              String
  payload           Json
  recordedAt        DateTime             @default(now())
  workspace         Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task              Task                 @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run               Run                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  nodeAttempt       TaskPlanNodeAttempt? @relation(fields: [nodeAttemptId], references: [id], onDelete: Cascade)

  @@unique([nodeAttemptId])
  @@index([runId, recordedAt])
  @@index([nodeAttemptId, recordedAt])
  @@index([taskId, kind])
}
