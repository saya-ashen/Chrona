{
  "name": "@chrona-org/cli",
  "version": "0.3.1",
  "private": true,
  "description": "Chrona — local AI work executor for governed planning, scheduling, recovery, and results",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/saya-ashen/Chrona.git"
  },
  "keywords": [
    "ai",
    "agent",
    "dashboard",
    "task-management",
    "cqrs",
    "event-sourcing",
    "vite"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "dev": "bun --watch apps/server/src/index.bun.ts",
    "server:start": "bun run apps/server/src/index.bun.ts",
    "build": "bun scripts/chrona.ts build",
    "start": "bun run server:start",
    "typecheck": "bunx tsc --noEmit --pretty false",
    "typecheck:app": "bunx tsc --noEmit --pretty false",
    "lint": "bun run lint:ratchet",
    "lint:warn": "eslint .",
    "lint:ratchet": "bun run scripts/lint-ratchet.ts",
    "smoke:entrypoints": "bun run scripts/smoke-entrypoints.ts",
    "test": "bun scripts/chrona.ts test all",
    "test:api": "bun run scripts/run-api-tests.ts",
    "test:bun": "bun run scripts/run-bun-tests.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate && bun run scripts/install-git-hooks.ts",
    "setup": "bun run db:generate && bun run db:seed",
    "db:seed": "bun prisma/seed.ts",
    "check:boundaries": "bun scripts/chrona.ts check boundaries",
    "ci:local": "bun run scripts/local-ci.ts",
    "hooks:install": "bun run scripts/install-git-hooks.ts",
    "build:smoke": "bun scripts/chrona.ts build smoke",
    "audit:security": "bun run scripts/audit-security.ts"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "hono": "^4.13.0",
    "imapflow": "^2.4.3",
    "mailparser": "^3.9.39",
    "nodemailer": "^10.1.1",
    "prisma-adapter-bun-sqlite": "^0.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^10.8.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "knip": "^6.32.0",
    "lefthook": "^2.1.10",
    "prisma": "7.9.1",
    "ts-morph": "^28.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.1",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "deepmerge-ts": "8.0.0",
    "fast-uri": "3.1.7",
    "fast-xml-parser": "5.10.1",
    "hono": "4.13.0",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.2",
    "mysql2": "3.22.0",
    "nanoid": "5.1.16",
    "postcss": "8.5.26",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "undici": "7.29.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*",
    "packages/*/*/*"
  ]
}
