{
  "name": "@chrona-org/cli",
  "version": "0.4.0-rc.1",
  "private": true,
  "description": "Chrona kernel, host, CLI and application SDK",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/saya-ashen/Chrona.git"
  },
  "keywords": [
    "ai",
    "agent",
    "local-first",
    "applications"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun --watch apps/cli/src/run.ts",
    "server:start": "bun run apps/cli/src/run.ts",
    "build": "bun scripts/chrona.ts build",
    "pack:sdk": "bun scripts/build/pack-sdk.ts",
    "start": "bun run server:start",
    "typecheck": "bunx tsc --noEmit --pretty false",
    "lint": "bun run lint:ratchet",
    "lint:warn": "eslint .",
    "lint:ratchet": "bun run scripts/lint-ratchet.ts",
    "smoke:entrypoints": "bun run scripts/smoke-entrypoints.ts",
    "test": "bun scripts/chrona.ts test all",
    "test:api": "bun run scripts/run-api-tests.ts",
    "test:bun": "bun run scripts/run-bun-tests.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate && bun run scripts/install-git-hooks.ts",
    "check:boundaries": "bun scripts/chrona.ts check boundaries",
    "check:guardrails": "bun run scripts/check-guardrails.ts",
    "verify:slice": "bun run scripts/verify-slice.ts",
    "verify:release": "bun run scripts/build/verify-release.ts",
    "deployment:preflight": "bun scripts/deployment-controls.ts preflight",
    "deployment:backup": "bun scripts/deployment-controls.ts backup",
    "deployment:accept": "bun scripts/deployment-controls.ts accept",
    "ci:local": "bun run scripts/local-ci.ts",
    "hooks:install": "bun run scripts/install-git-hooks.ts",
    "build:smoke": "bun scripts/chrona.ts build smoke",
    "audit:security": "bun run scripts/audit-security.ts"
  },
  "dependencies": {
    "@prisma/client": "7.9.1",
    "hono": "^4.13.18",
    "prisma-adapter-bun-sqlite": "^0.8.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.4",
    "dependency-cruiser": "^18.8.0",
    "enhanced-resolve": "^5.27.0",
    "eslint": "^10.15.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "lefthook": "^2.2.2",
    "prisma": "7.10.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.73.0"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "deepmerge-ts": "8.0.0",
    "effect": "3.22.1",
    "fast-uri": "3.1.7",
    "mysql2": "3.22.0"
  },
  "ignoreScripts": [],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma"
  ],
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
