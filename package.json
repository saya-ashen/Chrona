{
  "name": "@chrona-org/cli",
  "version": "0.1.5",
  "description": "Chrona — AI-native task control plane for planning, scheduling, and observing runtime-powered work",
  "license": "MIT",
  "type": "module",
  "bin": {
    "chrona": "./dist/cli.js"
  },
  "files": [
    "dist",
    "apps/web/dist",
    "external-plugins/hermes",
    "prisma/schema.prisma",
    "prisma/migrations",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/saya-ashen/Chrona.git"
  },
  "keywords": [
    "ai",
    "agent",
    "dashboard",
    "task-management",
    "cqrs",
    "event-sourcing",
    "vite"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "chrona": "bun run scripts/chrona.ts",
    "dev": "bun run scripts/dev.ts",
    "build": "bun run chrona build",
    "start": "bun run server:start",
    "typecheck": "bunx tsc --noEmit --pretty false",
    "server:start": "bun run apps/server/src/index.bun.ts",
    "lint": "eslint .",
    "deadcode": "knip --include unresolved,duplicates",
    "check": "bun run chrona check",
    "check:ui-foundation": "bun run scripts/check-ui-foundation.mjs",
    "analyze": "bun run chrona check all",
    "test": "bun run chrona test all",
    "test:unit": "bun run chrona test unit",
    "test:api": "bun run scripts/run-api-tests.ts",
    "test:bun": "bun run scripts/run-bun-tests.ts",
    "test:e2e": "playwright test",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:tablet": "playwright test --project=tablet",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:llm:replay": "bun run chrona test llm:replay",
    "db:generate": "prisma generate",
    "setup": "bun run db:generate && bun run db:seed",
    "db:seed": "bun prisma/seed.ts",
    "prepublishOnly": "bun run typecheck && bun run lint && bun run test:unit && bun run test:bun && bun run test:api && bun run deadcode && bun run check:ui-foundation && bun run check:boundaries && bun run chrona build web && bun run build:npm",
    "check:boundaries": "bun run chrona check boundaries",
    "build:npm": "bun run chrona build npm"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@hono/zod-validator": "^0.7.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "7.8.0",
    "hono": "^4.9.6",
    "prisma-adapter-bun-sqlite": "^0.7.1",
    "react-hook-form": "^7.75.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^17.3.10",
    "elkjs": "^0.11.1",
    "eslint": "^9",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.8.0",
    "jsdom": "^29.0.2",
    "knip": "^6.11.0",
    "lucide-react": "^1.7.0",
    "msw": "^2.14.6",
    "playwright": "^1.59.1",
    "prisma": "7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.5.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*",
    "packages/*/*/*"
  ]
}
