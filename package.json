{
  "name": "@chrona-org/cli",
  "version": "0.3.1",
  "private": true,
  "description": "Chrona — local AI work executor for governed planning, scheduling, recovery, and results",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/saya-ashen/Chrona.git"
  },
  "keywords": [
    "ai",
    "agent",
    "dashboard",
    "task-management",
    "cqrs",
    "event-sourcing",
    "vite"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "chrona": "bun run scripts/chrona.ts",
    "dev": "bun run scripts/dev.ts",
    "server:start": "bun run apps/server/src/index.bun.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "build": "bun run chrona build",
    "start": "bun run server:start",
    "typecheck": "bunx tsc --noEmit --pretty false && bunx tsc --project e2e/tsconfig.json --noEmit --pretty false",
    "typecheck:app": "bunx tsc --noEmit --pretty false",
    "typecheck:e2e": "bunx tsc --project e2e/tsconfig.json --noEmit --pretty false",
    "lint": "bun run lint:ratchet",
    "lint:warn": "eslint .",
    "lint:ratchet": "bun run scripts/lint-ratchet.ts",
    "assets:capture": "bun run scripts/assets.ts capture",
    "assets:motion": "bun run scripts/assets.ts capture-motion",
    "assets:import": "bun run scripts/assets.ts import",
    "assets:optimize": "bun run scripts/assets.ts optimize",
    "assets:check": "bun run scripts/assets.ts check",
    "assets": "bun run scripts/assets.ts all",
    "map:build": "bun run scripts/build-feature-test-map.ts",
    "smoke:entrypoints": "bun run scripts/smoke-entrypoints.ts",
    "map:check": "bun run scripts/build-feature-test-map.ts --check",
    "check:ui-foundation": "bun run scripts/check-ui-foundation.mjs",
    "check:release-consistency": "bun run scripts/check-release-consistency.ts",
    "analyze": "bun run chrona check all",
    "test": "bun run chrona test all",
    "test:ci": "bun run chrona test ci",
    "test:unit": "bun run chrona test unit",
    "test:api": "bun run scripts/run-api-tests.ts",
    "test:bun": "bun run scripts/run-bun-tests.ts",
    "test:feature": "bun run scripts/test-feature.ts --run",
    "test:e2e": "playwright test",
    "test:e2e:results": "playwright test --config playwright.results.config.ts",
    "test:e2e:work": "playwright test --config playwright.work.config.ts",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "test:e2e:library": "playwright test --config playwright.library.config.ts",
    "e2e:feature": "bun run scripts/test-feature.ts --kind e2e --run",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:tablet": "playwright test --project=tablet",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:llm:replay": "bun run chrona test llm:replay",
    "test:providers:compat": "CHRONA_RUN_LIVE_OMP_TESTS=1 CHRONA_RUN_LIVE_CLAUDE_TESTS=1 CHRONA_RUN_LIVE_CODEX_TESTS=1 bun test packages/providers/omp/src/omp-aimock-live.bun.test.ts packages/providers/claude-code/src/claude-code-aimock-live.bun.test.ts packages/providers/claude-code/src/claude-code-aimock-extra-live.bun.test.ts packages/providers/codex/src/codex-aimock-live.bun.test.ts",
    "test:providers:live": "bun run scripts/live-provider-smoke.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate && bun run scripts/install-git-hooks.ts",
    "setup": "bun run db:generate && bun run db:seed",
    "db:seed": "bun prisma/seed.ts",
    "db:seed:goal-acceptance": "bun prisma/seed-goal-acceptance.ts",
    "check:boundaries": "bun run chrona check boundaries",
    "check:boundaries:raw": "bun run chrona check boundaries",
    "ci:local": "bun run scripts/local-ci.ts",
    "hooks:install": "bun run scripts/install-git-hooks.ts",
    "build:smoke": "bun run chrona build smoke",
    "release:upgrade-smoke": "bun run scripts/release-upgrade-smoke.ts",
    "release:windows-acl-smoke": "bun run scripts/windows-private-storage-smoke.ts",
    "audit:security": "bun run scripts/audit-security.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@google/design.md": "^0.4.0",
    "@hono/zod-validator": "^0.9.0",
    "@mdxeditor/editor": "^4.2.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@open-file-viewer/core": "0.1.33",
    "@open-file-viewer/react": "0.1.33",
    "@prisma/client": "7.9.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@univerjs/core": "^0.25.1",
    "@univerjs/design": "^0.25.1",
    "@univerjs/preset-sheets-core": "^0.25.1",
    "@univerjs/presets": "^0.25.1",
    "headroom-ai": "^0.22.4",
    "hono": "^4.13.0",
    "ical.js": "^2.2.1",
    "pdfjs-dist": "^6.2.108",
    "prisma-adapter-bun-sqlite": "^0.8.0",
    "react-hook-form": "^7.84.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@copilotkit/aimock": "^1.43.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.3",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^18.5.0",
    "elkjs": "^0.12.0",
    "eslint": "^10.12.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "lucide-react": "^1.29.0",
    "msw": "^3.0.2",
    "playwright": "^1.63.0",
    "playwright-core": "1.63.0",
    "prisma": "7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.6.0",
    "ts-morph": "^28.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@xmldom/xmldom": "0.8.15",
    "adm-zip": "0.6.1",
    "brace-expansion": "5.0.12",
    "browserslist": "4.28.7",
    "deepmerge-ts": "8.0.0",
    "fast-uri": "3.1.7",
    "fast-xml-parser": "5.10.1",
    "hono": "4.13.0",
    "ip-address": "10.4.0",
    "js-yaml": "4.3.2",
    "mysql2": "3.22.0",
    "nanoid": "5.1.16",
    "postcss": "8.5.26",
    "proxy-addr": "2.0.8",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "undici": "7.29.1"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*",
    "packages/*/*/*"
  ]
}
