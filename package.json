{
  "name": "@chrona-org/cli",
  "version": "0.2.0",
  "private": true,
  "description": "Chrona — local AI work executor for governed planning, scheduling, recovery, and results",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/saya-ashen/Chrona.git"
  },
  "keywords": [
    "ai",
    "agent",
    "dashboard",
    "task-management",
    "cqrs",
    "event-sourcing",
    "vite"
  ],
  "packageManager": "bun@1.3.11",
  "engines": {
    "bun": ">=1.3.11"
  },
  "scripts": {
    "chrona": "bun run scripts/chrona.ts",
    "dev": "bun run scripts/dev.ts",
    "build": "bun run chrona build",
    "start": "bun run server:start",
    "typecheck": "bunx tsc --noEmit --pretty false && bunx tsc --project e2e/tsconfig.json --noEmit --pretty false",
    "typecheck:app": "bunx tsc --noEmit --pretty false",
    "typecheck:e2e": "bunx tsc --project e2e/tsconfig.json --noEmit --pretty false",
    "lint": "eslint . --max-warnings 853",
    "lint:warn": "eslint .",
    "check": "bun run chrona check",
    "assets:capture": "bun run scripts/assets.ts capture",
    "assets:import": "bun run scripts/assets.ts import",
    "assets:optimize": "bun run scripts/assets.ts optimize",
    "assets:check": "bun run scripts/assets.ts check",
    "assets": "bun run scripts/assets.ts all",
    "map:build": "bun run scripts/build-feature-test-map.ts",
    "map:check": "bun run scripts/build-feature-test-map.ts --check",
    "check:ui-foundation": "bun run scripts/check-ui-foundation.mjs",
    "analyze": "bun run chrona check all",
    "test": "bun run chrona test all",
    "test:ci": "bun run chrona test ci",
    "test:unit": "bun run chrona test unit",
    "test:api": "bun run scripts/run-api-tests.ts",
    "test:bun": "bun run scripts/run-bun-tests.ts",
    "test:feature": "bun run scripts/test-feature.ts --run",
    "test:e2e": "playwright test",
    "e2e:feature": "bun run scripts/test-feature.ts --kind e2e --run",
    "test:e2e:desktop": "playwright test --project=chromium",
    "test:e2e:tablet": "playwright test --project=tablet",
    "test:e2e:mobile": "playwright test --project=mobile",
    "test:llm:replay": "bun run chrona test llm:replay",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate && bun run scripts/install-git-hooks.ts",
    "setup": "bun run db:generate && bun run db:seed",
    "db:seed": "bun prisma/seed.ts",
    "check:boundaries": "bun run chrona check boundaries",
    "ci:local": "bun run scripts/local-ci.ts",
    "hooks:install": "bun run scripts/install-git-hooks.ts",
    "build:smoke": "bun run chrona build smoke"
  },
  "dependencies": {
    "@base-ui/react": "1.4.1",
    "@fontsource-variable/noto-sans-sc": "^5.2.10",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@google/design.md": "^0.3.0",
    "@hono/zod-validator": "^0.7.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "7.8.0",
    "@tanstack/react-table": "^8.21.3",
    "headroom-ai": "^0.22.4",
    "hono": "^4.9.6",
    "ical.js": "^2.2.1",
    "prisma-adapter-bun-sqlite": "^0.7.1",
    "react-hook-form": "^7.75.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@copilotkit/aimock": "^1.31.0",
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.3",
    "@xyflow/react": "^12.10.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dependency-cruiser": "^17.4.3",
    "elkjs": "^0.11.1",
    "eslint": "^9",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fast-check": "^4.8.0",
    "jsdom": "^29.0.2",
    "knip": "^6.11.0",
    "lefthook": "^2.1.10",
    "lucide-react": "^1.7.0",
    "msw": "^2.14.6",
    "playwright": "^1.59.1",
    "prisma": "7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.5.0",
    "ts-morph": "^28.0.0",
    "typescript": "^5",
    "typescript-eslint": "^8.46.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "esbuild",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/*/*",
    "packages/*/*/*"
  ]
}
