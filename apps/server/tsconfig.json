{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/generated/prisma/*": ["../../packages/db/src/generated/prisma/*"],
      "@server/*": ["./src/*"],
      "chrona": ["../../packages/app-sdk/sdk.ts"],
      "@chrona/logging": ["../../packages/logging/src/index.ts"],
      "@chrona/i18n/*": ["../../packages/i18n/src/*"],
      "@chrona/i18n": ["../../packages/i18n/src/index.ts"],
      "@chrona/shared/*": ["../../packages/shared/src/*"],
      "@chrona/shared": ["../../packages/shared/src/index.ts"],
      "@chrona/kernel/*": ["../../packages/kernel/src/*"],
      "@chrona/kernel": ["../../packages/kernel/src/index.ts"],
      "@chrona/workspaces": ["../../packages/workspaces/src/index.ts"],
      "@chrona/db/*": ["../../packages/db/src/*"],
      "@chrona/db": ["../../packages/db/src/index.ts"],
      "@chrona/contracts/*": ["../../packages/contracts/src/*"],
      "@chrona/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../packages/**/*.ts",
    "../../packages/**/*.tsx"
  ]
}
