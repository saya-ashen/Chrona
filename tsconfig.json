{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "paths": {
      "@/generated/prisma/*": ["./packages/db/src/generated/prisma/*"],
      "@/modules/*": ["./packages/engine/src/modules/*"],
      "@/lib/db": ["./packages/db/src/db.ts"],
      "@/lib/logger": ["./apps/web/src/lib/logger.ts"],
      "@/lib/demo-artifacts": ["./packages/db/src/demo-artifacts.ts"],
      "@/*": ["./apps/web/src/*"],
      "@web/*": ["./apps/web/src/*"],
      "@server/*": ["./apps/server/src/*"],
      "@features/*": ["./features/*"],
      "@shared/ui": ["./shared/ui/index.ts"],
      "shared/ui/*": ["./shared/ui/*"],
      "shared/ui/button": ["./shared/ui/button.tsx"],
      "shared/ui/badge": ["./shared/ui/badge.tsx"],
      "shared/ui/card": ["./shared/ui/card.tsx"],
      "shared/ui/select": ["./shared/ui/select.tsx"],
      "shared/ui/dropdown-menu": ["./shared/ui/dropdown-menu.tsx"],
      "@shared/http": ["./shared/http/index.ts"],
      "shared/http/*": ["./shared/http/*"],
      "shared/http/access-key": ["./shared/http/access-key.ts"],
      "shared/http/api-client": ["./shared/http/api-client.ts"],
      "@chrona/runtime-core": ["./packages/runtime-core/src/index.ts"],
      "@chrona/runtime-core/*": ["./packages/runtime-core/src/*"],
      "@chrona/logging": ["./packages/logging/src/index.ts"],
      "@chrona/i18n": ["./packages/i18n/src/locale.ts"],
      "@chrona/i18n/react": ["./packages/i18n/src/client.tsx"],
      "@chrona/i18n/*": ["./packages/i18n/src/*"],
      "@chrona/hermes": ["./packages/providers/hermes/src/index.ts"],
      "@chrona/hermes/*": ["./packages/providers/hermes/src/*"],
      "@chrona/providers-debug": ["./packages/providers/debug/src/index.ts"],
      "@chrona/providers-debug/*": ["./packages/providers/debug/src/*"],
      "@chrona/claude-code": ["./packages/providers/claude-code/src/index.ts"],
      "@chrona/claude-code/*": ["./packages/providers/claude-code/src/*"],
      "@chrona/acp-provider": ["./packages/providers/acp/src/index.ts"],
      "@chrona/acp-provider/*": ["./packages/providers/acp/src/*"],
      "@chrona/codex": ["./packages/providers/codex/src/index.ts"],
      "@chrona/codex/*": ["./packages/providers/codex/src/*"],
      "@chrona/omp": ["./packages/providers/omp/src/index.ts"],
      "@chrona/omp/*": ["./packages/providers/omp/src/*"],
      "@chrona/graph-runtime": ["./packages/graph-runtime/src/index.ts"],
      "@chrona/graph-runtime/*": ["./packages/graph-runtime/src/*"],
      "@chrona/domain": ["./packages/domain/src/index.ts"],
      "@chrona/domain/*": ["./packages/domain/src/*"],
      "@chrona/contracts": ["./packages/contracts/src/index.ts"],
      "@chrona/contracts/*": ["./packages/contracts/src/*"],
      "@chrona/ui-protocol": ["./packages/ui-protocol/src/index.ts"],
      "@chrona/ui-protocol/*": ["./packages/ui-protocol/src/*"],
      "@chrona/db": ["./packages/db/src/index.ts"],
      "@chrona/db/*": ["./packages/db/src/*"],
      "@chrona/shared": ["./packages/shared/src/index.ts"],
      "@chrona/shared/*": ["./packages/shared/src/*"],
      "@chrona/engine": ["./packages/engine/src/index.ts"],
      "@chrona/engine/*": ["./packages/engine/src/*"],
      "@chrona/integrations": ["./packages/integrations/src/index.ts"],
      "@chrona/integrations/*": ["./packages/integrations/src/*"],
      "@chrona/providers-foundation": ["./packages/providers/foundation/src/index.ts"],
      "@chrona/providers-foundation/*": ["./packages/providers/foundation/src/*"],
      "@chrona/web/*": ["./apps/web/src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "e2e", ".worktrees", "result", "dist"]
}
