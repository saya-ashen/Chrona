{
  "compilerOptions": {
    "baseUrl": ".", "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true, "skipLibCheck": true, "strict": true, "noEmit": true,
    "esModuleInterop": true, "module": "esnext", "moduleResolution": "bundler",
    "resolveJsonModule": true, "isolatedModules": true, "jsx": "react-jsx", "incremental": true,
    "allowUnreachableCode": false, "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true, "noImplicitOverride": true,
    "paths": {
      "@/generated/prisma/*": ["./packages/db/src/generated/prisma/*"],
      "@/lib/db": ["./packages/db/src/db.ts"],
      "@/lib/logger": ["./apps/web/src/lib/logger.ts"],
      "@/*": ["./apps/web/src/*"], "@web/*": ["./apps/web/src/*"],
      "@server/*": ["./apps/server/src/*"], "@features/*": ["./features/*"],
      "@shared/ui": ["./shared/ui/index.ts"],
      "@shared/http": ["./shared/http/index.ts"],
      "@chrona/logging": ["./packages/logging/src/index.ts"],
      "@chrona/i18n": ["./packages/i18n/src/index.ts"],
      "@chrona/i18n/react": ["./packages/i18n/src/client.tsx"],
      "@chrona/i18n/messages": ["./packages/i18n/src/messages.ts"],
      "@chrona/domain": ["./packages/domain/src/index.ts"],
      "@chrona/ui-catalog": ["./packages/ui-catalog/src/index.ts"],
      "@chrona/domain/steward/*": ["./packages/domain/src/steward/*"],
      "@chrona/contracts": ["./packages/contracts/src/index.ts"],
      "@chrona/contracts/steward": ["./packages/contracts/src/steward/index.ts"],
      "@chrona/db": ["./packages/db/src/index.ts"], "@chrona/db/*": ["./packages/db/src/*"],
      "@chrona/shared": ["./packages/shared/src/index.ts"], "@chrona/shared/*": ["./packages/shared/src/*"],
      "@chrona/engine": ["./packages/engine/src/index.ts"],
      "@chrona/integrations": ["./packages/integrations/src/index.ts"],
      "@chrona/integrations/steward": ["./packages/integrations/src/steward/index.ts"],
      "@chrona/web/*": ["./apps/web/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mts"],
  "exclude": ["node_modules", "e2e", ".worktrees", "result", "dist", "external-plugins/pi-steward-agent"]
}
