{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "paths": {
      "@/generated/prisma/*": [
        "./packages/db/src/generated/prisma/*"
      ],
      "@/lib/db": [
        "./packages/db/src/db.ts"
      ],
      "@server/*": [
        "./apps/server/src/*"
      ],
      "@chrona/logging": [
        "./packages/logging/src/index.ts"
      ],
      "@chrona/i18n": [
        "./packages/i18n/src/index.ts"
      ],
      "@chrona/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@chrona/domain/steward/*": [
        "./packages/domain/src/steward/*"
      ],
      "@chrona/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@chrona/contracts/steward": [
        "./packages/contracts/src/steward/index.ts"
      ],
      "@chrona/db": [
        "./packages/db/src/index.ts"
      ],
      "@chrona/db/*": [
        "./packages/db/src/*"
      ],
      "@chrona/shared": [
        "./packages/shared/src/index.ts"
      ],
      "@chrona/shared/*": [
        "./packages/shared/src/*"
      ],
      "@chrona/kernel": [
        "./packages/kernel/src/index.ts"
      ],
      "@chrona/kernel/test-support": [
        "./packages/kernel/src/test-support.ts"
      ],
      "@chrona/workspaces": [
        "./packages/workspaces/src/index.ts"
      ],
      "@chrona/pi": [
        "./packages/pi/src/index.ts"
      ],
      "@chrona/host": [
        "./packages/host/src/index.ts"
      ],
      "chrona": [
        "./packages/app-sdk/sdk.ts"
      ],
      "/pages.js": [
        "./.generated/applications/web/src/pages.tsx"
      ],
      "chrona/*": [
        "./packages/app-sdk/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "e2e",
    ".worktrees",
    "result",
    "dist",
    "artifacts",
    "plans",
    "packages/pi/resources"
  ]
}
