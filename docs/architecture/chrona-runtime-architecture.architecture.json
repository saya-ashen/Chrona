  "cards": [
    {
      "dot": "cyan",
      "title": "主路径",
      "items": [
        "用户操作经 REST/SSE 进入 Hono；执行引擎解析计划图、选择就绪节点并通过 Provider Bridge 派发。",
        "外部运行时用 MCP 工具提交结果或等待状态；UI 更新复用同一 HTTP/SSE 通道，不另画回线。"
      ]
    },
    {
      "dot": "rose",
      "title": "信任与权限",
      "items": [
        "服务默认绑定 127.0.0.1；配置 API_KEY 后使用 Bearer，公开绑定需显式开启不安全模式。",
        "MCP 仅公开 AI-safe node/branch refs；session、task、revision、idempotency 等隐藏上下文由服务端注入。"
      ]
    },
    {
      "dot": "violet",
      "title": "外部依赖与状态权威",
      "items": [
        "外部依赖集中在可配置 AI/Agent 运行时；Hermes 本地 CLI、插件和重启副作用由 integrations 层在用户确认后管理。",
        "Run、ExecutionSession、计划与事件作为事实进入 SQLite；TaskProjection 只由 rebuildTaskProjection 统一派生。"
      ]
    }
  ]
