  "cards": [
    {
      "dot": "cyan",
      "title": "命令与主循环",
      "items": [
        "createGraphRuntime.dispatch 校验并路由 start、resume、approval、retry、pause、cancel、mutation 与 submit_node_result。",
        "runGraphExecution 每轮重新解析 Effective Graph，选择 ready/forced 节点并创建带幂等键的 Snapshot 与 Attempt。"
      ]
    },
    {
      "dot": "amber",
      "title": "状态与返回语义",
      "items": [
        "done 在同一循环进入下一轮解析；等待、阻塞、失败、运行中、完成和取消保持独立返回状态。",
        "条件节点完成必须携带 selectedBranch；无执行器时返回 capability_unavailable，而不是静默跳过。"
      ]
    },
    {
      "dot": "rose",
      "title": "信任与包边界",
      "items": [
        "Graph Runtime 的直接包依赖仅为 @chrona/contracts/ai，不直接访问 Prisma、SQLite 或 Provider。",
        "执行、持久化和事件转发由 Engine callbacks 注入；辅助细节集中在卡片，不再增加回线。"
      ]
    }
  ]
}
