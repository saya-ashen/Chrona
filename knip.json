{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreBinaries": ["cc", "mkfifo"],
  "ignoreUnresolved": ["scripts/chrona.ts"],
  "ignoreDependencies": ["dependency-cruiser"],
  "ignoreIssues": {
    "packages/contracts/src/steward/module-candidates.ts": ["duplicates"]
  },
  "ignore": [
    "apps/cli/src/bun-entry.ts",
    "packages/db/src/generated/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts",
        "build/**/*.ts"
      ],
      "project": [
        "scripts/**/*.{ts,tsx}",
        "build/**/*.ts"
      ]
    },
    "apps/server": {
      "entry": ["src/**/*.bun.test.ts", "src/**/*.fixture.ts", "src/__tests__/fixtures/*.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/remote-device": {
      "entry": ["src/cli.ts", "src/**/*.bun.test.ts", "scripts/*.ts"],
      "project": ["src/**/*.ts", "scripts/*.ts"]
    },
    ".generated/applications/*": {
      "entry": ["index.ts", "build.ts", "src/**/*.tsx", "**/*.bun.test.ts", "test.ts"],
      "project": ["**/*.{ts,tsx}", "!vendor/**", "!runtime/**", "!node_modules/**"]
    },
    "packages/*": {
      "entry": ["src/**/*.bun.test.ts", "src/**/*.fixture.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/bun-entry.ts",
        "src/**/*.bun.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "!**/*.test.ts"
      ]
    },
    "packages/app-sdk": {
      "entry": [
        "sdk.ts",
        "preview.ts",
        "testing.ts",
        "process.ts",
        "transport.ts",
        "typecheck/check.ts",
        "typecheck/calls.ts",
        "typecheck/chrona-sdk-loader.ts"
      ],
      "project": [
        "**/*.ts",
        "!**/*.test.ts"
      ]
    },
    "packages/app-common": {
      "entry": [
        "src/*.ts",
        "src/*.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts"
      ]
    }
  }
}
