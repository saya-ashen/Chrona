{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "postcss.config.mjs",
    "packages/cli/src/bun-entry.ts",
    "packages/db/src/generated/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts"
      ],
      "project": [
        "scripts/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/*.spec.ts"
      ]
    },
    "apps/server": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    },
    "apps/web": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    },
    "packages/*/*": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    },
    "packages/*/*/*": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    }
  }
}
