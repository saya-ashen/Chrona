{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": [
    "apps/cli/src/bun-entry.ts",
    "packages/db/src/generated/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts"
      ],
      "project": [
        "scripts/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**",
        "!**/*.spec.ts"
      ]
    },
    "apps/server": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    },
    "packages/*": {
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/__tests__/**"
      ]
    },
    "packages/skills/chrona-node": {
      "entry": [
        "SKILL.md",
        "README.md",
        "package.json",
        "bin/chrona"
      ],
      "project": []
    },
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/bun-entry.ts"
      ],
      "project": [
        "src/**/*.ts",
        "!**/*.test.ts"
      ]
    },
    "packages/app-sdk": {
      "entry": [
        "sdk.ts",
        "testing.ts",
        "process.ts",
        "transport.ts",
        "typecheck/check.ts",
        "typecheck/calls.ts",
        "typecheck/chrona-sdk-loader.ts"
      ],
      "project": [
        "**/*.ts",
        "!**/*.test.ts"
      ]
    },
    "packages/app-common": {
      "entry": [
        "src/*.ts",
        "src/*.tsx"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "!**/*.test.ts"
      ]
    }
  }
}
