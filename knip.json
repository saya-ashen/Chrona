{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignoreBinaries": ["cc", "mkfifo"],
  "ignoreUnresolved": ["scripts/chrona.ts"],
  "ignoreDependencies": ["dependency-cruiser"],
  "ignoreIssues": {
    "packages/contracts/src/steward/module-candidates.ts": ["duplicates"]
  },
  "ignore": [
    "apps/cli/src/bun-entry.ts",
    "packages/db/src/generated/**"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.ts"
      ],
      "project": [
        "scripts/**/*.{ts,tsx}"
      ]
    },
    "apps/server": {
      "entry": ["src/**/*.bun.test.ts", "src/**/*.fixture.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/*": {
      "entry": ["src/**/*.bun.test.ts", "src/**/*.fixture.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/cli": {
      "entry": [
        "src/index.ts",
        "src/bun-entry.ts",
        "src/**/*.bun.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "!**/*.test.ts"
      ]
    },
    "packages/app-sdk": {
      "entry": [
        "sdk.ts",
        "preview.ts",
        "testing.ts",
        "process.ts",
        "transport.ts",
        "typecheck/check.ts",
        "typecheck/calls.ts",
        "chrona-sdk-loader.ts"
      ],
      "project": [
        "**/*.ts",
        "!**/*.test.ts"
      ]
    }
  }
}
