{
  "version": 1,
  "runtimes": [
    {
      "extensions": [".ts"],
      "programs": { "default": ["bun"] },
      "argv": ["--no-install"],
      "sdk": true,
      "preload": "chrona-sdk-loader.ts",
      "check": { "programs": { "default": ["bun"] }, "argv": ["--no-install", "{typecheck}/check.ts", "{module}", "{sdk}"] }
    },
    {
      "extensions": [".py"],
      "programs": { "default": ["python3", "python"], "win32": ["python", "py"] },
      "argv": [],
      "venv": { "default": ".venv/bin/python", "win32": ".venv/Scripts/python.exe" }
    },
    {
      "extensions": [".sh"],
      "programs": { "default": ["sh"] },
      "argv": []
    }
  ]
}
