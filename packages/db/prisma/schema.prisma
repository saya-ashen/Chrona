generator client {
  provider   = "prisma-client"
  engineType = "client"
  runtime    = "bun"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Workspace {
  id String @id @default(uuid())
  name String
  settings Json @default(dbgenerated("'{}'"))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  agentContexts AgentContext[]
  modules Module[]
  timers Timer[]
  runs Run[]
  approvals Approval[]
  invocations ModuleInvocation[]
  audits Audit[]
  stewardState StewardState?
  agentCommands AgentCommand[]
  agentProviders AgentProvider[]
  kernelFacts KernelFact[]
  factConsumer KernelFactConsumer?
  candidateAdmissions CandidateAdmission[]
  installations ModuleInstallation[]
  installationHeads ModuleInstallationHead[]
  moduleRemovals ModuleRemoval[]
}

model Module {
  id String @id @default(uuid())
  workspaceId String
  name String
  activeHash String?
  activationId String @default(uuid())
  executionFenceAt DateTime?
  dataSchema Int?
  status String @default("active")
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  versions ModuleVersion[]
  runs ModuleRun[]
  calls ModuleCall[]
  timers Timer[]
  agentContexts AgentContext[]
  approvals Approval[]
  executionResults ModuleExecutionResult[]
  activations ModuleActivation[]
  migration ModuleMigration?
  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

model ModuleVersion {
  id String @id @default(uuid())
  moduleId String
  hash String
  manifest Json
  intent Json
  source String
  report Json
  status String
  createdAt DateTime @default(now())
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([moduleId, hash])
  @@index([moduleId, status, createdAt])
  @@index([moduleId, createdAt, id])
}

model ModuleRun {
  id String @id @default(uuid())
  moduleId String
  hash String
  triggerId String
  firedAt DateTime
  exitCode Int
  output Json?
  error String?
  createdAt DateTime @default(now())
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@index([moduleId, createdAt, id])
  @@index([moduleId, hash, firedAt])
}

model ModuleCall {
  id String @id @default(uuid())
  moduleId String?
  /// Immutable budget attribution survives removal of the owning application.
  accountingModuleId String?
  workspaceId String?
  moduleName String?
  hash String
  moduleRunId String?
  eventKey String?
  method String
  key String
  status String
  error String?
  inputTokens Int?
  outputTokens Int?
  createdAt DateTime @default(now())
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  @@index([moduleId, method, key, status])
  @@index([moduleRunId])
}

/// A call routed by Chrona to a module tool. Async calls are stored here until delivered; sync calls are only recorded.
/// `caller` is Chrona's record of who called (`module:<id>`, `kernel`, `provider:<runId>`, `owner`), never caller-supplied.
model ModuleInvocation {
  id String @id @default(uuid())
  workspaceId String
  caller String
  callerModuleId String?
  callerHash String?
  /// Actual originating Agent Run, bound by the kernel before tool delivery.
  runId String?
  run Run? @relation(fields: [runId], references: [id], onDelete: SetNull)
  target String
  /// Stable routed identity; private non-routed records may omit it.
  targetIdentity String @default("")
  targetBound Boolean @default(false)
  targetModuleId String?
  targetHash String?
  targetContractHash String?
  tool String
  args Json
  key String
  /// Canonical input digest; sensitive arguments are not retained.
  requestDigest String?
  /// Module names on the call path, the caller last.
  chain Json @default(dbgenerated("'[]'"))
  mode String
  /// The target tool declared itself safe to run twice when the call was made.
  idempotent Boolean @default(false)
  status String @default("queued")
  attempts Int @default(0)
  nextAttemptAt DateTime?
  leaseToken String?
  leaseUntil DateTime?
  output Json?
  /// Lifecycle status is separate from the immutable submission receipt.
  operationOutput Json?
  error String?
  errorCode String?
  errorReason String?
  reply Boolean @default(false)
  replyAttempts Int @default(0)
  repliedAt DateTime?
  createdAt DateTime @default(now())
  finishedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, caller, targetIdentity, tool, key])
  @@index([workspaceId, status, nextAttemptAt])
  @@index([workspaceId, mode, createdAt])
  @@index([workspaceId, reply, repliedAt])
  @@index([runId, status])
}

/// Kernel wake-up only; calendar policy and labels belong to the owning app.
model Timer {
  id String @id @default(uuid())
  workspaceId String
  moduleId String
  timerId String
  rule Json
  payload Json?
  status String @default("active")
  nextAt DateTime?
  lastAt DateTime?
  lastResult String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([moduleId, timerId])
  @@index([workspaceId, status, nextAt])
  @@index([moduleId, status])
}

model Run {
  id String @id @default(uuid())
  workspaceId String
  sessionId String?
  lane String
  trigger String
  status String @default("queued")
  provider String
  agentAdmission AgentRunAdmission?
  agentProvider AgentRunProvider?
  providerLaunch ProviderLaunch?
  invocations ModuleInvocation[]
  events RunEvent[]
  eventSequence Int @default(0)
  interactions RunInteraction[]
  /// Cancellation is durable authority, never inferred from audit history.
  cancelRequestedAt DateTime?
  /// pending | unknown | confirmed; error text is presentation only.
  stopStatus String @default("pending")
  tokenHash String @unique
  leaseUntil DateTime?
  deadlineAt DateTime?
  prompt String
  summary String?
  label String?
  cwd String
  toolCalls Json @default(dbgenerated("'[]'"))
  error String?
  startedAt DateTime?
  endedAt DateTime?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  session AgentContext? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  @@index([workspaceId, lane, status, createdAt])
  @@index([workspaceId, status, leaseUntil])
  @@index([workspaceId, status, deadlineAt])
  @@index([sessionId, createdAt])
}

model Approval {
  id String @id @default(uuid())
  workspaceId String
  moduleId String?
  action String
  title String
  detail String
  preview String
  payload Json
  status String @default("open")
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, createdAt])
  @@index([moduleId, status])
}

model Audit {
  id String @id @default(uuid())
  workspaceId String
  kind String
  subjectId String?
  actorKey String
  details Json
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
  @@index([workspaceId, subjectId, createdAt])
}

model StewardState {
  workspaceId String @id
  lastTickAt DateTime?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Version-bound execution context; removed applications leave stopped history intact.
model AgentContext {
  id String @id @default(uuid())
  workspaceId String
  ownerId String
  moduleId String?
  hash String
  cwd String?
  providerId String?
  providerRevision String?
  providerSessionId String?
  status String @default("active")
  createdAt DateTime @default(now())
  lastActivityAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  module Module? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  runs Run[]
  @@index([workspaceId, moduleId])
  @@index([workspaceId, status, lastActivityAt])
}

/// Workspace-local registration owned permanently by its actual registering module.
model AgentProvider {
  workspaceId String
  id String
  moduleId String
  hash String
  revision String
  declaration Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@id([workspaceId, id])
  @@index([workspaceId, moduleId])
}

/// Immutable provider and configuration selection made in the Run enqueue transaction.
model AgentRunProvider {
  runId String @id
  providerId String
  moduleId String
  hash String
  revision String
  declaration Json
  providerOptions Json
  completion      Json?
  kind String @default("conversation")
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([moduleId, hash])
}

/// Exact tool/content selection admitted for one Run and its original application.
model AgentRunAdmission {
  runId String @id
  moduleId String
  hash String
  targets Json
  content Json
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// Fixed idempotency receipt; stores the argument digest, never control input or answers.
model AgentCommand {
  id String @id
  workspaceId String
  moduleId String
  hash String
  operation String
  requestDigest String
  output Json
  settled Boolean
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, moduleId])
}

/// Admission of the exact Provider launch bound to its Run.
model ProviderLaunch {
  runId String @id
  digest String
  createdAt DateTime @default(now())
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
}

/// Bounded redacted structured events; not Provider transcript text or audit records.
model RunEvent {
  runId String
  sequence Int
  kind String
  payload Json
  createdAt DateTime @default(now())
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@id([runId, sequence])
}

/// Safe question metadata and terminal receipt. Answer bodies are never persisted.
model RunInteraction {
  id String @id
  runId String
  request Json
  status String @default("pending")
  createdAt DateTime @default(now())
  settledAt DateTime?
  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  @@index([runId, createdAt, id])
}

/// Immutable finite kernel fact, with an independent consumption receipt.
model KernelFact {
  id String @id
  workspaceId String
  payload Json
  consumedBy String?
  consumedAt DateTime?
  createdAt DateTime
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, consumedAt, createdAt, id])
}

model KernelFactConsumer {
  workspaceId String @id
  moduleId String?
  revision String
  updatedAt DateTime
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

/// Owner-issued exact material admission, not a model execution grant.
model CandidateAdmission {
  id String @id
  workspaceId String
  requestKey String
  submitterModuleId String
  submitterHash String
  targets Json
  issuer Json
  createdAt DateTime
  receipt CandidateReceipt?
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model CandidateReceipt {
  id String @id
  admissionId String @unique
  requestKey String
  requestDigest String
  state String
  approvalId String?
  createdAt DateTime
  admission CandidateAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  /// Canonical complete immutable set; missing lookup bindings cannot erase membership.
  members Json
  memberBindings CandidateMember[]
}

/// Exact immutable candidate identities; retained even after an application is removed.
model CandidateMember {
  versionId String @id
  receiptId String
  receipt CandidateReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  @@index([receiptId])
}

/// Execution policy receipts, independent of optional audit retention.
model ModuleExecutionResult {
  id String @id
  moduleId String
  hash String
  activationId String
  resultId String
  outcome String
  consecutiveFailures Int
  createdAt DateTime
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@unique([activationId, resultId])
  @@index([moduleId, activationId, createdAt, id])
}

/// One governed activation epoch; updates never replace its identity or ordering.
model ModuleActivation {
  activationId String @id
  moduleId String
  previousHash String?
  candidateHash String
  activatedAt String
  status String
  changes Json
  checks Json
  observedCapabilities Json
  dataHandling String
  nextAction String
  rollback Json
  createdAt DateTime
  updatedAt DateTime
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  @@index([moduleId, candidateHash, createdAt])
  @@index([moduleId, updatedAt])
}

/// Private installation request and its current bounded receipt, retained after removal.
model ModuleInstallation {
  id String @id
  workspaceId String
  requestKey String
  package String
  mode String
  status String
  moduleId String?
  hash String?
  approvalId String?
  errorCode String?
  errorReason String?
  errorMessage String?
  createdAt DateTime @default(now())
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  heads ModuleInstallationHead[]
  submission ModuleInstallationSubmission?
  @@unique([workspaceId, requestKey])
}

model ModuleInstallationHead {
  workspaceId String
  package String
  installationId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  installation ModuleInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  @@id([workspaceId, package])
}

model ModuleInstallationSubmission {
  id String @id
  installationId String @unique
  hash String
  moduleId String?
  existingVersionId String?
  marker String
  phase String
  error String?
  installation ModuleInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
}

/// Removal evidence survives application deletion and audit retention.
model ModuleRemoval {
  moduleId String @id
  workspaceId String
  name String
  hash String?
  createdAt DateTime
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, name, hash, createdAt])
}

model ModuleMigration {
  moduleId String @id
  hash String
  fromSchema Int?
  toSchema Int
  previousStatus String
  createdAt DateTime
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)
}
