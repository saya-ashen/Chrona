{
  "name": "mind",
  "description": "Chrona 的心智：维护用户未完成之事的关注清单，定时感知整体情况（含应用经 contributes.mind.attention 交出的截止、异常与待处理事项），由直觉模型（可选）或规则判断是否值得唤醒 Chrona 思考并推进。",
  "entry": "index.ts",
  "triggers": [
    {"id": "sense", "schedule": {"kind": "every", "minutes": 5}},
    {"id": "daily", "schedule": {"kind": "daily", "time": "09:00"}}
  ],
  "effects": ["network"],
  "uses": ["chat.today", "chat.runs", "modules.list", "modules.contributions", "provider.wake"],
  "secrets": ["mind_intuition"],
  "settings": {
    "enabled": {"type": "boolean", "label": "主动唤醒", "description": "关闭后心智不再唤醒 Chrona。", "default": true},
    "interval-minutes": {"type": "number", "label": "感知间隔（分钟）", "default": 15, "min": 5, "max": 120},
    "daily-wakes": {"type": "number", "label": "每 24 小时最多唤醒次数", "default": 6, "min": 1, "max": 24},
    "intuition-url": {"type": "string", "label": "直觉模型接口", "description": "System One 决策接口（Jev 格式，如 https://api.typesafe.ai/v1/systemone）；留空则按规则判断。变化摘要与关注清单（标题按“发给直觉模型的细节”）会发送到该服务。凭据 mind_intuition 的 key 字段作为 Bearer 发送。", "default": "", "maxLength": 500},
    "intuition-model": {"type": "string", "label": "直觉模型", "default": "jev-latest", "maxLength": 100},
    "intuition-daily-calls": {"type": "number", "label": "直觉每 24 小时最多调用次数", "default": 96, "min": 1, "max": 1000},
    "wake-threshold": {"type": "number", "label": "唤醒阈值", "description": "直觉认为值得唤醒的概率不低于此值时唤醒。", "default": 0.75, "min": 0.5, "max": 1},
    "sleep-threshold": {"type": "number", "label": "不唤醒阈值", "description": "概率不高于此值时不唤醒；介于两个阈值之间按规则判断。", "default": 0.25, "min": 0, "max": 0.5},
    "intuition-detail": {"type": "string", "label": "发给直觉模型的细节", "description": "titles：发送关注与变化的标题；minimal：只发送编号、类别、状态与时间，不发任何标题。", "default": "titles", "options": ["titles", "minimal"]}
  },
  "data": {"schema": 1},
  "tests": ["test.ts"],
  "tools": [
    {"name": "agenda", "description": "List the user's open matters Chrona is looking after (the mind's agenda); all: true includes done and dropped ones of the last 30 days.", "examples": [{"args": {}, "result": {"now": "2026-11-01T05:20:00.000Z", "concerns": []}}], "sideEffects": [], "output": {"type": "object", "properties": {"now": {"type": "string"}, "concerns": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "goal": {"type": "string"}, "status": {"enum": ["watching", "acting", "waiting-user", "waiting-external", "done", "dropped"]}, "dueAt": {"type": "string"}, "revisitAt": {"type": "string"}, "escalation": {"enum": ["none", "early", "day-before", "final"]}, "commitments": {"type": "array", "items": {"type": "object", "properties": {"at": {"type": "string"}, "text": {"type": "string"}}, "required": ["at", "text"], "additionalProperties": false}}, "userSignals": {"type": "array", "items": {"type": "object", "properties": {"at": {"type": "string"}, "text": {"type": "string"}}, "required": ["at", "text"], "additionalProperties": false}}, "lastAssessment": {"type": "object", "properties": {"at": {"type": "string"}, "conclusion": {"type": "string"}, "by": {"enum": ["mind", "chat", "user"]}}, "required": ["at", "conclusion", "by"], "additionalProperties": false}, "createdAt": {"type": "string"}, "updatedAt": {"type": "string"}}, "required": ["id", "title", "status", "escalation", "commitments", "userSignals", "createdAt", "updatedAt"], "additionalProperties": false}}}, "required": ["now", "concerns"], "additionalProperties": false}, "parameters": {"type": "object", "properties": {"all": {"type": "boolean", "description": "Include closed matters"}}}},
    {"name": "note", "description": "Create (no id) or update one matter on the agenda: when the user hands over something to follow, finishes, drops or changes it, or after assessing it. Escalation only rises.", "examples": [{"args": {"title": "CLS 2027 申请", "goal": "2027 PhD 申请", "status": "waiting-user", "due-at": "2026-11-02T22:59:00Z", "revisit-at": "2026-11-01T12:00:00Z", "commitment": "11/1 20:00 提醒用户提交"}}], "sideEffects": ["Writes the matter to the mind's agenda; nothing is sent or scheduled."], "errors": [{"code": "error", "description": "Unknown id, missing title for a new matter, invalid status, escalation or time, or too many open matters.", "recovery": "Read the agenda, then send a valid id and fields."}], "output": {"anyOf": [{"type": "object", "properties": {"concern": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}, "escalation": {"type": "string"}}, "required": ["id", "title", "status", "escalation"]}}, "required": ["concern"], "additionalProperties": false}, {"type": "object", "properties": {"error": {"type": "string"}}, "required": ["error"], "additionalProperties": false}]}, "parameters": {"type": "object", "properties": {"id": {"type": "string", "description": "Matter id from agenda; omit to create"}, "title": {"type": "string", "description": "Short title (new matters need one)"}, "goal": {"type": "string", "description": "The longer-term goal it serves"}, "status": {"type": "string", "description": "Where it stands", "enum": ["watching", "acting", "waiting-user", "waiting-external", "done", "dropped"]}, "due-at": {"type": "string", "description": "Hard deadline, ISO time; empty clears"}, "revisit-at": {"type": "string", "description": "When to look again, ISO time; empty clears"}, "escalation": {"type": "string", "description": "Deadline reminder step reached", "enum": ["none", "early", "day-before", "final"]}, "conclusion": {"type": "string", "description": "What the latest assessment found"}, "commitment": {"type": "string", "description": "Something Chrona did or promised the user"}, "user-signal": {"type": "string", "description": "What the user said about it (done, dropped, don't mention again)"}, "wake-id": {"type": "string", "description": "The mind wake this assessment belongs to, if any"}}}},
    {"name": "report", "description": "End a mind wake: what it led to (acted, notified, asked, or nothing after checking) and one sentence why.", "examples": [{"args": {"wake-id": "w-1a2b3c4d", "outcome": "nothing", "summary": "已核实 CLS 提醒在位，用户已知，明晚复查"}, "result": {"ok": true}}], "sideEffects": ["Records the outcome in the mind's decision log."], "errors": [{"code": "error", "description": "Unknown wake-id or missing fields.", "recovery": "Use the wake-id from the wake brief."}], "output": {"anyOf": [{"type": "object", "properties": {"ok": {"const": true}}, "required": ["ok"], "additionalProperties": false}, {"type": "object", "properties": {"error": {"type": "string"}}, "required": ["error"], "additionalProperties": false}]}, "parameters": {"type": "object", "properties": {"wake-id": {"type": "string", "description": "From the wake brief"}, "outcome": {"type": "string", "description": "What the wake led to", "enum": ["acted", "notified", "asked", "nothing"]}, "summary": {"type": "string", "description": "One sentence"}}, "required": ["wake-id", "outcome", "summary"]}},
    {"name": "decisions", "description": "The mind's recent judgements (newest first) and 7-day wake statistics.", "examples": [{"args": {"limit": 10}}], "sideEffects": [], "output": {"type": "object", "properties": {"entries": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "at": {"type": "string"}, "source": {"type": "string"}, "wake": {"type": "boolean"}, "focus": {"type": "string"}, "outcome": {"type": "object"}}, "required": ["id", "at", "source", "wake", "focus"]}}, "stats": {"type": "object"}}, "required": ["entries", "stats"], "additionalProperties": false}, "parameters": {"type": "object", "properties": {"limit": {"type": "number", "description": "1-100, default 20"}}}}
  ]
}
