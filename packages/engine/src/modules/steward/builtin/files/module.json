{
  "name": "files",
  "description": "Browse, read, write and organize documents; inspect and restore file history.",
  "entry": "index.ts",
  "content": true,
  "activated": true,
  "uses": ["web.page-set"],
  "triggers": [],
  "effects": [],
  "data": { "schema": 1 },
  "tests": ["test.ts"],
  "tools": [
    { "name": "list", "description": "List a document directory.", "examples": [{ "args": { "dir": "reports" }, "result": { "dir": "reports", "parent": "", "entries": [], "truncated": false } }], "sideEffects": [], "errors": [{ "code": "error", "description": "The directory is missing or unsafe.", "recovery": "Check the directory path and use a path inside the documents area." }], "output": { "anyOf": [{ "type": "object", "properties": { "dir": { "type": "string" }, "parent": { "type": ["string", "null"] }, "entries": { "type": "array", "items": { "type": "object", "properties": { "name": { "type": "string" }, "kind": { "enum": ["directory", "file"] }, "path": { "type": "string" } }, "required": ["name", "kind", "path"], "additionalProperties": false } }, "truncated": { "type": "boolean" } }, "required": ["dir", "parent", "entries", "truncated"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"], "additionalProperties": false }] }, "parameters": { "type": "object", "properties": { "dir": { "type": "string" } } } },
    { "name": "read", "description": "Read text (truncated to fit); binary files return size and MIME only.", "examples": [{ "args": { "path": "reports/summary.txt" } }], "sideEffects": [], "errors": [{ "code": "error", "description": "The file is missing or unsafe.", "recovery": "Check the file path with files.list." }], "output": { "anyOf": [{ "type": "object", "properties": { "size": { "type": "integer" }, "mime": { "type": "string" }, "content": { "type": "string" }, "truncated": { "type": "boolean" } }, "required": ["size", "mime"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"], "additionalProperties": false }] }, "parameters": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] } },
    { "name": "write", "description": "Write a text document, keeping its history.", "examples": [{ "args": { "path": "reports/summary.txt", "content": "Updated summary" }, "result": { "ok": true } }], "sideEffects": ["Writes or replaces a document and records its prior and current version in history."], "errors": [{ "code": "error", "description": "The path is invalid or cannot be written safely.", "recovery": "Use a relative path inside the documents area and correct the content." }], "output": { "anyOf": [{ "type": "object", "properties": { "ok": { "const": true } }, "required": ["ok"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"], "additionalProperties": false }] }, "parameters": { "type": "object", "properties": { "path": { "type": "string" }, "content": { "type": "string" } }, "required": ["path", "content"] } },
    { "name": "move", "description": "Move a file or directory without overwriting an existing item.", "examples": [{ "args": { "from": "drafts/summary.txt", "to": "reports/summary.txt" }, "result": { "ok": true } }], "sideEffects": ["Moves the file or directory and records affected file versions in history."], "errors": [{ "code": "error", "description": "The source is missing, a path is unsafe, or the destination already exists.", "recovery": "List both directories, then choose an existing source and unused destination." }], "output": { "anyOf": [{ "type": "object", "properties": { "ok": { "const": true } }, "required": ["ok"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"], "additionalProperties": false }] }, "parameters": { "type": "object", "properties": { "from": { "type": "string" }, "to": { "type": "string" } }, "required": ["from", "to"] } },
    { "name": "delete", "description": "Move a file or directory into .trash, preserving its history.", "examples": [{ "args": { "path": "drafts/old.txt" }, "result": { "ok": true, "path": ".trash/<generated-id>/drafts/old.txt" } }], "sideEffects": ["Moves the file or directory under .trash; it does not permanently erase it."], "errors": [{ "code": "error", "description": "The path is missing or unsafe.", "recovery": "Check the path with files.list; the item is not removed when this call fails." }], "output": { "anyOf": [{ "type": "object", "properties": { "ok": { "const": true }, "path": { "type": "string" } }, "required": ["ok", "path"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"], "additionalProperties": false }] }, "parameters": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] } },
    { "name": "history", "description": "List the last 20 file versions, oldest first; deleted versions are marked.", "examples": [{ "args": { "path": "reports/summary.txt" }, "result": { "versions": [] } }], "sideEffects": [], "output": { "anyOf": [{ "type": "object", "properties": { "versions": { "type": "array", "items": { "type": "object", "properties": { "version": { "type": "string" }, "at": { "type": "string" }, "size": { "type": "integer" }, "deleted": { "type": "boolean" }, "hash": { "type": ["string", "null"] } }, "required": ["version", "at", "size", "deleted", "hash"], "additionalProperties": false } } }, "required": ["versions"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"], "additionalProperties": false }] }, "parameters": { "type": "object", "properties": { "path": { "type": "string" } }, "required": ["path"] } },
    { "name": "restore", "description": "Restore a file from a version returned by history.", "examples": [{ "args": { "path": "reports/summary.txt", "version": "<version-id-from-history>" }, "result": { "ok": true } }], "sideEffects": ["Replaces the current file content with a selected historical version and records history."], "errors": [{ "code": "error", "description": "The requested version is missing or was a deletion record.", "recovery": "Call files.history and select a listed non-deleted version." }], "output": { "anyOf": [{ "type": "object", "properties": { "ok": { "const": true } }, "required": ["ok"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" } }, "required": ["error"], "additionalProperties": false }] }, "parameters": { "type": "object", "properties": { "path": { "type": "string" }, "version": { "type": "string" } }, "required": ["path", "version"] } }
  ]
}
