    { "name": "page-set", "output": {"type": "object", "properties": {"id": {"type": "string"}, "catalog": {"type": "string"}}, "required": ["id", "catalog"], "additionalProperties": false}, "description": "Register or replace one page of the calling app (idempotent; call on every start). spec is a json-render spec using web.catalog's components; data and call actions reference the app's own tools. Errors list what is invalid.", "visibility": ["modules"], "idempotent": true,
      "parameters": { "type": "object", "properties": { "id": { "type": "string", "description": "Page slug, e.g. main" }, "title": { "type": "string" }, "data": { "type": "object", "properties": {}, "additionalProperties": true, "description": "{ name: { tool, args?, refresh? } }" }, "spec": { "type": "object", "properties": {}, "additionalProperties": true, "description": "json-render spec { root, elements }" } }, "required": ["id", "title", "spec"] } },
    { "name": "page-remove", "output": {"type": "object", "properties": {"removed": {"type": "boolean"}}, "required": ["removed"], "additionalProperties": false}, "description": "Remove one of the calling app's pages.", "visibility": ["modules"], "idempotent": true,
