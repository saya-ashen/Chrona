{
  "name": "web",
  "description": "Chrona's web page: today, conversations and apps; its data API at /api/web makes routed calls for the user.",
  "entry": "index.ts",
  "keepAlive": true,
  "listen": ["/", "/api/web"],
  "triggers": [],
  "effects": [],
  "uses": ["agent.context", "agent.run", "agent.get", "agent.stream", "agent.write", "agent.interrupt", "agent.respond", "activity.runtime", "activity.runs", "approvals.list", "approvals.resolve", "modules.health", "notify.list", "notify.status", "settings.get", "settings.update", "schedules.list", "schedules.update", "secrets.list", "secrets.set", "secrets.remove", "modules.list", "modules.tools", "modules.interfaces", "modules.permissions", "modules.settings-get", "modules.diagnostics", "notify.activity", "*", "modules.contributions", "modules.build-sessions", "modules.build-session", "modules.build-transcript", "modules.build-settings", "notify.settings", "approvals.grants", "approvals.revoke-grant", "modules.settings-set"],
  "tools": [
    { "name": "today", "description": "The web application's overview, shared with owner clients.", "visibility": ["kernel", "owner", "modules"], "idempotent": true,
      "output": {"type": "object", "properties": {"generatedAt": {"type": "string"}, "approvals": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "string"}, "createdAt": {"type": "string"}}, "required": ["id", "title", "status", "createdAt"], "additionalProperties": true}}, "upcoming": {"type": "array", "items": {"type": "object", "properties": {"label": {"type": ["string", "null"]}, "at": {"type": "string"}}, "required": ["label", "at"], "additionalProperties": true}}, "updates": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "moduleId": {"type": ["string", "null"]}, "title": {"type": "string"}, "body": {"type": "string"}, "feedback": {"type": ["string", "null"]}, "createdAt": {"type": "string"}}, "required": ["id", "moduleId", "title", "body", "feedback", "createdAt"], "additionalProperties": true}}, "apps": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "problems": {"type": "array", "items": {"type": "object", "additionalProperties": true}}, "sessions": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": ["string", "null"]}, "status": {"type": "string"}, "lastActivityAt": {"type": "string"}}, "required": ["title", "status", "lastActivityAt"], "additionalProperties": true}}, "health": {"type": "object", "properties": {"provider": {"type": "object", "properties": {"available": {"type": "boolean"}}, "required": ["available"], "additionalProperties": true}}, "required": ["provider"], "additionalProperties": true}}, "required": ["generatedAt", "approvals", "upcoming", "updates", "apps", "problems", "sessions", "health"], "additionalProperties": false},
      "parameters": { "type": "object", "properties": {} } },
    { "name": "reply", "description": "A reply in one of this page's conversations, pushed by Chrona.", "visibility": ["modules"],
      "output": { "type": "object", "properties": { "pages": { "type": "integer" } }, "required": ["pages"], "additionalProperties": false },
      "parameters": { "type": "object", "properties": { "session": { "type": "string" }, "message": { "type": "string" }, "text": { "type": "string" }, "workspace": { "type": "string" }, "attachments": { "type": "string" }, "in-reply-to": { "type": "string" } }, "required": ["session", "message", "text"] } },
    { "name": "page-set", "output": {"type": "object", "properties": {"id": {"type": "string"}, "catalog": {"type": "string"}}, "required": ["id", "catalog"], "additionalProperties": false}, "description": "Register or replace a caller-owned page. Optional declarative components expand before catalog/tool checks; layout controls only content. Register on every start.", "visibility": ["modules"], "idempotent": true,
      "parameters": { "type": "object", "properties": { "id": { "type": "string", "description": "Page slug, e.g. main" }, "title": { "type": "string" }, "layout": { "type": "string", "enum": ["document", "workspace"], "description": "Content layout; global navigation and theme remain Web-owned." }, "components": { "type": "object", "properties": {}, "additionalProperties": true, "description": "App-private declarative templates keyed app:Name; see web.catalog." }, "content": { "type": "object", "properties": { "tool": { "type": "string" } }, "required": ["tool"], "additionalProperties": false, "description": "Own visible tool accepting {ref}, returning null or {base64,mime} for bounded raster images; see web.catalog." }, "data": { "type": "object", "properties": {}, "additionalProperties": true, "description": "{ name: { tool, args?, refresh? } }" }, "spec": { "type": "object", "properties": {}, "additionalProperties": true, "description": "json-render spec { root, elements }" } }, "required": ["id", "title", "spec"] } },
    { "name": "page-remove", "output": {"type": "object", "properties": {"removed": {"type": "boolean"}}, "required": ["removed"], "additionalProperties": false}, "description": "Remove one of the calling app's pages.", "visibility": ["modules"], "idempotent": true,
      "parameters": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },
    { "name": "pages", "output": {"type": "object", "properties": {"items": {"type": "array", "items": {"type": "object", "properties": {"id": {"type": "string"}, "title": {"type": "string"}, "updatedAt": {"type": "string"}}, "required": ["id", "title", "updatedAt"], "additionalProperties": false}}}, "required": ["items"], "additionalProperties": false}, "description": "The calling app's registered pages.", "visibility": ["modules"], "idempotent": true,
      "parameters": { "type": "object", "properties": {}, "required": [] } },
    { "name": "catalog", "output": {"type": "object", "properties": {"catalog": {"type": "string"}, "components": {"type": "object", "additionalProperties": true}, "rules": {"type": "array", "items": {"type": "string"}}}, "required": ["catalog", "components", "rules"], "additionalProperties": false}, "description": "Components, props and rules for page specs (json-render version included).", "visibility": ["modules", "provider"], "idempotent": true,
      "parameters": { "type": "object", "properties": {}, "required": [] } }
  ],
  "content": true,
  "settings": {
    "memory-provider": {
      "type": "string",
      "label": "记忆应用",
      "description": "应用名；留空关闭记忆。不自动安装应用。",
      "default": "",
      "maxLength": 41
    },
    "memory-auto-recall": {
      "type": "boolean",
      "label": "自动召回记忆",
      "default": true
    },
    "memory-auto-retain": {
      "type": "boolean",
      "label": "自动保存记忆",
      "default": true
    }
  },
  "data": { "schema": 1 },
  "tests": ["test.ts"]
}
