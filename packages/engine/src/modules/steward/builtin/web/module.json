{
  "name": "web",
  "description": "Chrona's web page: today, conversations and apps; its data API at /api/web makes routed calls for the user.",
  "entry": "index.ts",
  "keepAlive": true,
  "listen": ["/", "/api/web"],
  "triggers": [],
  "effects": [],
  "uses": ["chat.send", "chat.file", "chat.session", "chat.sessions", "chat.messages", "chat.transcript", "chat.today", "chat.runs", "chat.answer", "chat.cancel", "approvals.resolve", "settings.get", "settings.update", "settings.grants", "settings.revoke-grant", "settings.preferences", "settings.forget", "schedules.list", "schedules.update", "modules.list", "modules.tools", "*"],
  "tools": [
    { "name": "reply", "description": "A reply in one of this page's conversations, pushed by Chrona.", "visibility": ["modules"], "callers": ["chat"],
      "parameters": { "type": "object", "properties": { "session": { "type": "string" }, "message": { "type": "string" }, "text": { "type": "string" }, "workspace": { "type": "string" }, "attachments": { "type": "string" }, "in-reply-to": { "type": "string" } }, "required": ["session", "message", "text"] } }
  ],
  "data": { "schema": 1 },
  "tests": ["test.ts"]
}
