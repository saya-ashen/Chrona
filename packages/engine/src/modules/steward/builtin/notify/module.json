{
  "name": "notify",
  "description": "Tells the user things: budget (daily cap, quiet hours, digest), channel and recipient choice, delivery through registered channel modules.",
  "entry": "index.ts",
  "keepAlive": true,
  "triggers": [],
  "effects": [],
  "uses": ["modules.list", "modules.tools"],
  "tools": [
    { "name": "send", "description": "Queue a notification for the user. The budget decides now, digest or web; a repeated key is dropped.", "visibility": ["modules", "kernel"], "idempotent": true,
      "output": { "anyOf": [{ "type": "object", "properties": { "id": { "type": "string" }, "status": { "type": "string" }, "duplicate": { "type": "boolean" } }, "required": ["id", "status", "duplicate"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "const": "invalid" }, "message": { "type": "string" } }, "required": ["error", "message"], "additionalProperties": false }] },
      "parameters": { "type": "object", "required": ["key", "level", "title", "body"], "properties": {
        "key": { "type": "string", "description": "Idempotency key, derived from what is being reported" },
        "level": { "type": "string", "enum": ["now", "digest", "web"] },
        "title": { "type": "string" }, "body": { "type": "string" },
        "format": { "type": "string", "enum": ["text", "markdown"], "description": "Body format; omitted means text. Markdown body over 4000 or title over 200 UTF-16 code units is rejected, never truncated." },
        "module": { "type": "string", "description": "Chrona only: the app (module id) this is about" },
        "app": { "type": "string", "description": "Chrona only: the app's name" },
        "session": { "type": "string", "description": "Conversation to link to" },
        "approval": { "type": "string", "description": "Chrona only: open approval this asks about" },
        "scoped": { "type": "boolean" }, "urgent": { "type": "boolean" },
        "responds": { "type": "boolean", "description": "Answers something the user asked: no cap or quiet hours" },
        "recipient": { "type": "string", "description": "Channel recipient to pin the message to" } } } },
    { "name": "withdraw", "description": "Drop a queued notification that is no longer relevant.", "visibility": ["kernel"], "idempotent": true,
      "parameters": { "type": "object", "required": ["key"], "properties": { "key": { "type": "string" } } } },
    { "name": "channel", "description": "Register the caller's local delivery tool and readiness. The delivery tool must be visible to modules; channel names belong to the registering module.", "visibility": ["modules"], "idempotent": true,
      "output": { "anyOf": [{ "type": "object", "properties": { "ready": { "type": "boolean" } }, "required": ["ready"], "additionalProperties": false }, { "type": "object", "properties": { "ignored": { "type": "boolean" } }, "required": ["ignored"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } }, "required": ["error", "message"], "additionalProperties": false }] },
      "parameters": { "type": "object", "required": ["channel", "tool", "ready", "at"], "properties": { "channel": { "type": "string" }, "tool": { "type": "string", "description": "Local tool name, without a module prefix" }, "ready": { "type": "boolean" }, "at": { "type": "string" } } } },
    { "name": "list", "description": "Recent notifications, newest first.", "visibility": ["kernel", "owner"], "idempotent": true,
      "output": { "type": "object", "properties": { "items": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "moduleId": { "type": ["string", "null"] }, "sessionId": { "type": ["string", "null"] }, "level": { "type": "string" }, "channel": { "type": ["string", "null"] }, "status": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" }, "format": { "type": "string", "enum": ["text", "markdown"] }, "link": { "type": ["string", "null"] }, "attempts": { "type": "integer" }, "lastError": { "type": ["string", "null"] }, "createdAt": { "type": "string" }, "sentAt": { "type": ["string", "null"] }, "feedback": { "type": ["string", "null"] } }, "required": ["id", "moduleId", "sessionId", "level", "channel", "status", "title", "body", "format", "link", "attempts", "lastError", "createdAt", "sentAt", "feedback"], "additionalProperties": false } } }, "required": ["items"], "additionalProperties": false },
      "parameters": { "type": "object", "properties": { "limit": { "type": "number" } } } },
    { "name": "status", "description": "Channel readiness and queue counts.", "visibility": ["kernel"], "idempotent": true, "parameters": { "type": "object" } },
    { "name": "feedback", "description": "The user's feedback on a notification.", "visibility": ["kernel", "owner"],
      "output": { "anyOf": [{ "type": "object", "properties": { "notification": { "type": "object", "properties": { "id": { "type": "string" }, "moduleId": { "type": ["string", "null"] }, "sessionId": { "type": ["string", "null"] }, "level": { "type": "string" }, "channel": { "type": ["string", "null"] }, "status": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" }, "format": { "type": "string", "enum": ["text", "markdown"] }, "link": { "type": ["string", "null"] }, "attempts": { "type": "integer" }, "lastError": { "type": ["string", "null"] }, "createdAt": { "type": "string" }, "sentAt": { "type": ["string", "null"] }, "feedback": { "type": ["string", "null"] } }, "required": ["id", "moduleId", "sessionId", "level", "channel", "status", "title", "body", "format", "link", "attempts", "lastError", "createdAt", "sentAt", "feedback"], "additionalProperties": false } }, "required": ["notification"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } }, "required": ["error", "message"], "additionalProperties": false }] },
      "parameters": { "type": "object", "required": ["id", "feedback"], "properties": { "id": { "type": "string" }, "feedback": { "type": "string", "enum": ["useful", "not_useful"] } } } },
    { "name": "retry", "description": "Queue a failed notification again.", "visibility": ["kernel", "owner"],
      "output": { "anyOf": [{ "type": "object", "properties": { "notification": { "type": "object", "properties": { "id": { "type": "string" }, "moduleId": { "type": ["string", "null"] }, "sessionId": { "type": ["string", "null"] }, "level": { "type": "string" }, "channel": { "type": ["string", "null"] }, "status": { "type": "string" }, "title": { "type": "string" }, "body": { "type": "string" }, "format": { "type": "string", "enum": ["text", "markdown"] }, "link": { "type": ["string", "null"] }, "attempts": { "type": "integer" }, "lastError": { "type": ["string", "null"] }, "createdAt": { "type": "string" }, "sentAt": { "type": ["string", "null"] }, "feedback": { "type": ["string", "null"] } }, "required": ["id", "moduleId", "sessionId", "level", "channel", "status", "title", "body", "format", "link", "attempts", "lastError", "createdAt", "sentAt", "feedback"], "additionalProperties": false } }, "required": ["notification"], "additionalProperties": false }, { "type": "object", "properties": { "error": { "type": "string" }, "message": { "type": "string" } }, "required": ["error", "message"], "additionalProperties": false }] },
      "parameters": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } } },
    { "name": "configure", "description": "The user's notification settings.", "visibility": ["kernel"], "idempotent": true,
      "parameters": { "type": "object", "required": ["daily-cap", "timezone", "digest-at", "at"], "properties": {
        "daily-cap": { "type": "number" }, "quiet-start": { "type": "string" }, "quiet-end": { "type": "string" },
        "timezone": { "type": "string" }, "digest-at": { "type": "string" }, "at": { "type": "string" } } } },
    { "name": "import", "description": "Chrona only: notifications recorded before this module existed (JSON array).", "visibility": ["kernel"], "idempotent": true,
      "parameters": { "type": "object", "required": ["rows"], "properties": { "rows": { "type": "string" } } } }
  ],
  "data": { "schema": 2, "migrate": "migrate.ts" },
  "tests": ["test.ts", "format-test.ts"]
}
