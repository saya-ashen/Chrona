        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "offset": {
            "type": "integer"
          },
          "nextOffset": {
            "type": "integer"
          },
          "eof": {
            "type": "boolean"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "size",
          "offset",
          "nextOffset",
          "eof",
          "content"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list",
      "description": "List a source or package directory (maximum 200 entries, 16 KiB output). Use path '' or '.' for the public root; missing paths return not_found. Unsafe entries fail the operation.",
      "visibility": [
        "provider",
        "modules",
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          }
        },
        "required": [
          "path"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
