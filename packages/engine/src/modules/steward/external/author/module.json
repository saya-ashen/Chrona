        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON {requestKey,submitter:{moduleId,hash},targets:[{name,moduleId,expectedActiveHash}],goal,intent:{changes,preserves?}}. New targets use null/null. The real owner-entry principal must discover and verify the current approved Author identity via modules.list before issuing admission."
          }
        },
        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "material-preparation"
          },
          "request": {
            "type": "object",
            "properties": {
              "goal": {
                "type": "string"
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "moduleId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "expectedActiveHash": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "moduleId",
                    "expectedActiveHash"
                  ],
                  "additionalProperties": false
                }
              },
              "intent": {
                "type": "object",
                "properties": {
                  "changes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "preserves": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "changes",
                  "preserves"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "goal",
              "targets",
              "intent"
            ],
            "additionalProperties": false
          },
          "admission": {
            "type": "object",
            "properties": {
              "requestKey": {
                "type": "string"
              },
              "submitter": {
                "type": "object",
                "properties": {
                  "moduleId": {
                    "type": "string"
                  },
                  "hash": {
                    "type": "string"
                  }
                },
                "required": [
                  "moduleId",
                  "hash"
                ],
                "additionalProperties": false
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "moduleId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "expectedActiveHash": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "moduleId",
                    "expectedActiveHash"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "requestKey",
              "submitter",
              "targets"
            ],
            "additionalProperties": false
          },
          "prompt": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "request",
          "admission",
          "prompt"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "write",
      "description": "Write UTF-8 source text under sources/<workspace>/file. Maximum 64 KiB per file. Rejects symlinks, hard links and special files.",
      "visibility": [
        "provider",
        "modules",
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read",
      "description": "Read a UTF-8 source or staged file in a bounded range. Offsets and limit count UTF-16 code units; limit is 1–2000. Rejects files over 64 KiB.",
