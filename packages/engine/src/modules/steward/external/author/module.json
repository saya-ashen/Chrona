{
  "name": "author",
  "description": "Ordinary source and binary material transport. Guides the current Agent, imports explicit workspace files, exports complete versions, stages material and forwards stable kernel receipts.",
  "entry": "index.ts",
  "content": true,
  "activated": true,
  "uses": [
    "modules.source",
    "modules.submit",
    "modules.receipt"
  ],
  "effects": [],
  "data": {
    "schema": 1
  },
  "tests": [
    "test.ts"
  ],
  "tools": [
    {
      "name": "prepare",
      "description": "Prepare complete-first authoring guidance and admission metadata for the current Agent Run. Input JSON: {requestKey,submitter:{moduleId,hash},targets:[{name,moduleId,expectedActiveHash}],goal,intent:{changes,preserves}}.",
