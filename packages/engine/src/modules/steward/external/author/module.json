              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "file",
                    "directory"
                  ]
                }
              },
              "required": [
                "name",
                "kind"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "path",
          "entries"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stage",
      "description": "Atomically copy complete recorded source and binary artifacts into a new package stage, preserving executable modes and declared provenance. Verifies manifest name and entry; kernel checks remain required. No overwrite.",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON {name,from:\"sources/workspace\",to:\"packages/stage\",provenance:{kind:\"local\",label}|{kind:\"kernel-source\",moduleId,hash,ref,materialDigest}}. Provenance is caller-declared."
          }
        },
        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "dir": {
            "type": "string"
          },
          "metadata": {
            "type": "string"
          },
          "files": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "materialDigest": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "dir",
          "metadata",
          "files",
          "bytes",
          "materialDigest"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "source",
      "description": "Ask modules.source to export an admitted immutable version into an empty own sources/<workspace>. Returns its unmodified result; no host paths or network.",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON {admissionId,moduleId,hash,to:\"sources/workspace\"}. Kernel binds caller and authorized source."
          }
        },
        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "submit",
      "description": "Submit an entire admitted candidate set from own relative source directories. Returns the kernel receipt unchanged. Never issues admission or runs models.",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON {admissionId,requestKey,items:[{name,dir,intent:{changes,preserves?}}]}. dir is sources/workspace or packages/stage/source. Use original admission and request key after a lost reply."
          }
        },
        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "receipt",
      "description": "Read the exact kernel candidate receipt. Preserves unknown and errors, performs no retry, never selects latest.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON {receiptId} OR {admissionId,requestKey}, exactly one selector."
          }
        },
        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "import",
      "description": "Copy selected source and binary artifacts from a trusted-local project directory into sources/<workspace>. Input JSON: {from,to,source:[...],artifacts?:[...],build?:...,overwrite?:boolean}. Set overwrite:true to replace an existing workspace.",
