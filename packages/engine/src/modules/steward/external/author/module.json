      "name": "export",
      "description": "Copy a complete own version including binary bytes and executable modes into a trusted-local absolute directory. For updates first use author.source for the exact admitted baseline. Optional overwrite: true replaces that destination after staging; no caller/Run authority.",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON: {path,to,overwrite?:boolean}."
