        "properties": {
          "path": {
            "type": "string"
          },
          "record": {
            "type": "string"
          },
          "files": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "materialDigest": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "record",
          "files",
          "bytes",
          "materialDigest"
        ],
        "additionalProperties": false
