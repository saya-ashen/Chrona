    {
      "name": "validate",
      "description": "Validate a complete sources/<workspace> before submission: module manifest, entry, tools/pages, dependency lock and bounded safe files. Runs local bun tests by default with a 30s timeout and 8 KiB output. Does not submit or establish product acceptance.",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON {path:\"sources/workspace\",runTests?:boolean}. runTests defaults to true; set false to skip local tests."
          }
        },
        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "path": {
            "type": "string"
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "ok": {
                  "type": "boolean"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
