        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "files": {
            "type": "integer"
          },
          "bytes": {
            "type": "integer"
          },
          "materialDigest": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "to",
          "files",
          "bytes",
          "materialDigest"
        ],
        "additionalProperties": false
      }
