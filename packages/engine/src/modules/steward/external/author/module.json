        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "JSON: {from,to,source:[...],artifacts?:[...],build?:...,overwrite?:boolean}."
