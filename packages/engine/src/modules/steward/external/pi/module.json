            "properties": {
              "profile": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "thinking": {
                "type": "string",
                "enum": [
                  "",
                  "off",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            },
            "additionalProperties": false
