    {
      "name": "configure",
      "description": "读取或替换当前用户的 Pi 配置目录、模型和思考强度",
      "visibility": [
        "owner"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "config": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "thinking": {
                "type": "string",
                "enum": [
                  "off",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "clear": {
            "type": "boolean"
          },
          "view": {
            "type": "boolean"
          },
          "form": {
            "type": "object",
