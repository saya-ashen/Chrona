                    "type": "null"
                  }
                ]
              },
              "modelSource": {
                "type": "string",
                "enum": [
                  "configuration",
                  "host",
                  "profile",
                  "pi-default"
                ]
              },
              "thinking": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "off",
                      "minimal",
                      "low",
                      "medium",
                      "high",
                      "xhigh",
                      "max"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "thinkingSource": {
                "type": "string",
                "enum": [
                  "configuration",
                  "host",
                  "profile",
                  "pi-default"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          },
