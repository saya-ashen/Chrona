          "config": {
            "type": "object",
            "properties": {
              "profile": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "thinking": {
                "type": "string",
                "enum": [
                  "off",
                  "minimal",
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              }
            },
            "additionalProperties": false
          },
          "revision": {
            "type": "string"
          },
          "effective": {
            "type": "object",
            "required": [
              "profile",
              "profileSource",
              "profileStatus",
              "model",
              "modelSource",
              "thinking",
              "thinkingSource",
              "warnings"
