{
  "name": "pi",
  "description": "Pi 执行提供方：管理进程、会话、原生协议和当前用户的配置资源。可选预装应用。",
  "entry": "index.ts",
  "keepAlive": true,
  "activated": true,
  "uses": [
    "agent.register",
    "runtime-callback.event",
    "web.page-set"
  ],
  "effects": [
    "network"
  ],
  "data": {
    "schema": 1
  },
  "tests": [
    "test-entry.ts"
  ],
  "tools": [
    {
      "name": "health",
      "description": "Pi health: kernel-bound provider endpoint",
      "visibility": [
        "kernel"
      ],
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output": {
        "type": "object",
        "required": [
          "name",
          "supportsRunModel",
          "complete",
          "available",
          "sandboxed",
          "error"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "supportsRunModel": {
            "type": "boolean"
          },
          "complete": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "sandboxed": {
            "type": "boolean"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
