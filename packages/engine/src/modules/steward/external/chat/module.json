{
  "name": "chat",
  "description": "Chat：独立中文对话工作台，私有会话、草稿、图片、工具选择及可核对的执行恢复。",
  "entry": "index.ts",
  "keepAlive": true,
  "activated": true,
  "authority": "owner",
  "content": true,
  "data": {
    "schema": 1
  },
  "effects": [],
  "uses": [
    "agent.providers",
    "agent.run",
    "agent.read",
    "agent.write",
    "agent.stop",
    "agent.native",
    "modules.describe",
    "modules.list",
    "modules.receipt",
    "modules.health",
    "web.component-set",
    "web.page-set",
    "web.pages",
    "pi.configure",
    "pi.models",
    "mind.context",
    "mind.updates",
    "mind.task-view",
    "mind.task-control"
  ],
  "tests": [
    "test.ts"
  ],
  "tools": [
    {
      "name": "catalog",
      "description": "发现真实 Provider 配置与按应用分组的工具",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list",
      "description": "读取 Chat 自己的会话列表",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "create",
      "description": "以持久requestKey幂等新建会话，重试返回同一会话；默认全部可委派工具启用，emptyTools显式关闭后手动选择",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string",
            "description": "稳定的新建请求key，1至128字符；未知结果重试必须复用"
          },
          "emptyTools": {
            "type": "boolean"
          }
        },
        "required": [
          "requestKey"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "read",
      "description": "核对已有执行及读取会话；observe=true 仅观测，不恢复待执行命令",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "observe": {
            "type": "boolean"
          }
        },
        "required": [
          "id"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "draft",
      "description": "保存每会话草稿和下一轮配置（版本冲突拒绝覆盖）",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "patch": {
            "type": "string"
          },
          "revision": {
            "type": "number",
            "description": "minimum: 0; integer revision"
          }
        },
        "required": [
          "id",
          "patch",
          "revision"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "edit",
      "description": "重命名、置顶或归档 Chat 会话",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "patch": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "patch"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delete",
      "description": "确认后删除此 Chat 会话和此会话附件",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "confirmed"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "upload",
      "description": "上传 Chat 所有的 PNG/JPEG/GIF/WebP 图片，单张2MiB最多10张；不解析 PDF",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "mime": {
            "type": "string"
          },
          "base64": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "mime",
          "base64"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "detach",
      "description": "移除此会话待发送图片",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "attachmentId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "attachmentId"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "image",
      "description": "读取此会话拥有的图片",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "attachmentId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "attachmentId"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "execute",
      "description": "按稳定调用 key 发送/补充/回答/停止；不确定结果先核对不重发",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "send",
              "message",
              "answer",
              "stop"
            ]
          },
          "input": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "key",
          "kind",
          "input"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "native",
      "description": "通过已有 Run 只读查询真实 Provider 状态或可用模型",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "get_state",
              "get_available_models"
            ]
          }
        },
        "required": [
          "id",
          "key",
          "type"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "delivery",
      "description": "按精确 receiptId 核对交付；模型文本不代表安装激活或验收",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "receiptId": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "receiptId"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "new-context",
      "description": "明确确认后开始新执行上下文，保留Chat消息；未确认请求不允许切换。",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "confirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "confirmed"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "observations",
      "description": "纯读取已公开的持久来源事件；不核对或启动 Agent；epoch+cursor恢复，撤回不泄漏旧片段",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "sourceEpoch": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "limit": {
            "type": "number",
            "description": "integer 1..50; default 50"
          },
          "maxBytes": {
            "type": "number",
            "description": "integer 1..32768; UTF-8 JSON bytes; metadata too small explicitly rejected"
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "snapshot",
      "description": "纯读取已发送对象；可按 inventory token固定水位；范围缩小立即拒绝旧token",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "objectRef": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "message",
                  "operation",
                  "conversation",
                  "execution"
                ]
              },
              "id": {
                "type": "string"
              },
              "revision": {
                "type": "number"
              }
            },
            "required": [
              "kind",
              "id"
            ],
            "additionalProperties": false
          },
          "expectedRevision": {
            "type": "number"
          },
          "snapshotToken": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "number",
            "description": "integer 1..50; default 50"
          },
          "maxBytes": {
            "type": "number",
            "description": "integer 1..32768; UTF-8 JSON bytes; metadata too small explicitly rejected"
          }
        },
        "required": [
          "objectRef"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "observation-inventory",
      "description": "固定来源epoch、范围版本和高水位的有界重建清单；token五分钟/进程重启失效",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "snapshotToken": {
            "type": "string"
          },
          "cursor": {
            "type": "string"
          },
          "limit": {
            "type": "number",
            "description": "integer 1..50; default 50"
          },
          "maxBytes": {
            "type": "number",
            "description": "integer 1..32768; UTF-8 JSON bytes; metadata too small explicitly rejected"
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "observation-scope",
      "description": "owner学习范围：默认关闭，只从开启后新提交消息；版本化排除/私密立即撤回，不回扫历史",
      "visibility": [
        "owner"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "expectedRevision": {
            "type": "number"
          },
          "enabled": {
            "type": "boolean"
          },
          "conversationId": {
            "type": "string"
          },
          "excluded": {
            "type": "boolean"
          },
          "private": {
            "type": "boolean"
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "task-view",
      "description": "Read the owner’s persistent tasks, or one task and its actual progress/artifacts. User interface only; no Agent execution.",
      "visibility": [
        "owner",
        "modules"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "artifactRef": {
            "type": "string"
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ]
      }
    },
    {
      "name": "task-control",
      "description": "Supplement, pause or resume the same persistent task through existing Mind feedback/control. Requires authenticated owner interface and original action key/revisions.",
      "visibility": [
        "owner",
        "modules"
      ],
      "idempotent": false,
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string"
          }
        },
        "required": [
          "input"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "json": {
            "type": "string"
          }
        },
        "required": [
          "json"
        ]
      }
    }
  ]
}
