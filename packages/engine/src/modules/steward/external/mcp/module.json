{
  "name": "mcp",
  "description": "Owner MCP endpoint at /api/mcp for the user's own agents.",
  "entry": "index.ts",
  "keepAlive": true,
  "listen": "/api/mcp",
  "triggers": [],
  "effects": [],
  "uses": ["agent.context", "agent.run", "agent.get", "agent.stream", "agent.write", "agent.interrupt", "agent.respond", "web.today", "activity.runs", "approvals.list", "approvals.resolve", "modules.list", "modules.tools", "*", "modules.contributions", "modules.settings-get", "modules.build-sessions", "modules.build-session", "modules.build-transcript"],
  "settings": {
    "memory-provider": {
      "type": "string",
      "label": "记忆应用",
      "description": "应用名；留空关闭记忆。不自动安装应用。",
      "default": "",
      "maxLength": 41
    },
    "memory-auto-recall": {
      "type": "boolean",
      "label": "自动召回记忆",
      "default": true
    },
    "memory-auto-retain": {
      "type": "boolean",
      "label": "自动保存记忆",
      "default": true
    }
  },
  "data": { "schema": 1 },
  "tests": ["test.ts"]
}
