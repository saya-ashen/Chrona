{
  "name": "mcp",
  "description": "Owner MCP endpoint at /api/mcp using current routed contracts and app-owned conversations.",
  "entry": "index.ts",
  "keepAlive": true,
  "listen": "/api/mcp",
  "effects": [],
  "uses": [
    "*",
    "web.page-set"
  ],
  "tools": [
    {
      "name": "settings",
      "description": "Read or update this MCP application's private memory preferences. settings is a strict partial JSON object with provider, autoRecall and autoRetain.",
      "visibility": [
        "owner"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "settings": {
            "type": "string"
          }
        },
        "required": []
      },
      "idempotent": true,
      "output": {
        "type": "object",
        "properties": {
          "provider": {
            "type": [
              "string",
              "null"
            ]
          },
          "autoRecall": {
            "type": "boolean"
          },
          "autoRetain": {
            "type": "boolean"
          }
        },
        "required": [
          "provider",
          "autoRecall",
          "autoRetain"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ui-settings",
      "description": "Read or update MCP memory preferences through scalar settings controls. Empty provider disables memory; omitted fields are preserved.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "description": "Memory provider app slug, or empty to disable memory."
          },
          "auto-recall": {
            "type": "boolean"
          },
          "auto-retain": {
            "type": "boolean"
          }
        }
      },
      "output": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string"
          },
          "autoRecall": {
            "type": "boolean"
          },
          "autoRetain": {
            "type": "boolean"
          }
        },
        "required": [
          "provider",
          "autoRecall",
          "autoRetain"
        ],
        "additionalProperties": false
      }
    }
  ],
  "data": {
    "schema": 1
  },
  "tests": [
    "test.ts"
  ],
  "activated": true
}
