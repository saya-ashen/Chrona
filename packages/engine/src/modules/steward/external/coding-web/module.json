{
  "name": "coding-web",
  "description": "Optional owner Coding workbench. Browser state owns navigation and drafts; bounded tools translate to the headless Coding command protocol. Removing this client leaves Coding running.",
  "entry": "index.ts",
  "activated": true,
  "authority": "owner",
  "uses": [
    "*",
    "coding.command",
    "web.page-set"
  ],
  "effects": [],
  "data": {
    "schema": 1
  },
  "tests": [
    "test.ts"
  ],
  "tools": [
    {
      "name": "ui-request",
      "description": "Prepare a browser-held request key without business effects.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {},
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "nextRequestKey": {
            "type": "string"
          }
        },
        "required": [
          "nextRequestKey"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ui-catalog",
      "description": "Read projects and conversations; never persist client selection.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": []
      },
      "output": {
        "type": "object",
        "properties": {
          "projects": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "projectRef": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "isDefault": {
                  "type": "boolean"
                }
              },
              "required": [
                "projectRef",
                "path",
                "label",
                "isDefault"
              ],
              "additionalProperties": false
            }
          },
          "sessions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "projectRef": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "title",
                "projectRef"
              ],
              "additionalProperties": false
            }
          },
          "notice": {
            "type": "string"
          },
          "after": {
            "type": "string"
          }
        },
        "required": [
          "projects",
          "sessions",
          "notice",
          "after"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ui-work",
      "description": "Read one explicit conversation, current questions, progress and results.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "session-id": {
            "type": "string"
          },
          "before": {
            "type": "string"
          }
        },
        "required": [
          "session-id"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "goal": {
            "type": "string"
          },
          "workId": {
            "type": [
              "string",
              "null"
            ]
          },
          "runId": {
            "type": "string"
          },
          "attemptId": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "statusTone": {
            "enum": [
              "neutral",
              "success",
              "warning",
              "danger"
            ]
          },
          "stop": {
            "type": "string"
          },
          "canSend": {
            "type": "boolean"
          },
          "canStop": {
            "type": "boolean"
          },
          "hasQuestions": {
            "type": "boolean"
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "help": {
                  "type": "string"
                },
                "method": {
                  "type": "string"
                },
                "choices": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "questionId": {
                        "type": "string"
                      },
                      "label": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "questionId",
                      "label"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "title",
                "help",
                "method",
                "choices"
              ],
              "additionalProperties": false
            }
          },
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "author": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "timestamp": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "author",
                "content",
                "timestamp",
                "status"
              ],
              "additionalProperties": false
            }
          },
          "historyBefore": {
            "type": "string"
          },
          "hasEarlier": {
            "type": "boolean"
          },
          "historyPage": {
            "type": "string"
          },
          "limited": {
            "type": "boolean"
          },
          "progress": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "sequence": {
                  "type": "number"
                },
                "text": {
                  "type": "string"
                }
              },
              "required": [
                "sequence",
                "text"
              ],
              "additionalProperties": false
            }
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "ref": {
                  "type": "string"
                },
                "accepted": {
                  "type": "boolean"
                },
                "checks": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "ref",
                "accepted",
                "checks"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sessionId",
          "project",
          "goal",
          "workId",
          "runId",
          "attemptId",
          "status",
          "statusTone",
          "stop",
          "canSend",
          "canStop",
          "hasQuestions",
          "questions",
          "messages",
          "historyBefore",
          "hasEarlier",
          "historyPage",
          "limited",
          "progress",
          "results"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ui-command",
      "description": "Translate a fixed workbench action to one Coding command. Retain request-key across uncertain delivery; pending outcomes require receipt inspection.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "request-key": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "session-id": {
            "type": "string"
          },
          "run-id": {
            "type": "string"
          },
          "attempt-id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "original": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "work-id": {
            "type": "string",
            "description": "Empty for the first round; current work ID otherwise."
          },
          "action": {
            "enum": [
              "register-project",
              "default-project",
              "create",
              "send",
              "answer",
              "stop",
              "retry"
            ],
            "type": "string"
          }
        },
        "required": [
          "action",
          "request-key"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "requestKey": {
            "type": "string"
          },
          "nextRequestKey": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "project",
          "sessionId",
          "requestKey",
          "nextRequestKey",
          "status",
          "message",
          "retryable"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ui-receipt",
      "description": "Inspect a Coding operation receipt without replaying it.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "request-key": {
            "type": "string"
          },
          "project": {
            "type": "string"
          },
          "session-id": {
            "type": "string"
          }
        },
        "required": [
          "request-key"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "project": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "requestKey": {
            "type": "string"
          },
          "nextRequestKey": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "accepted",
              "rejected"
            ]
          },
          "message": {
            "type": "string"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "project",
          "sessionId",
          "requestKey",
          "nextRequestKey",
          "status",
          "message",
          "retryable"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "ui-result",
      "description": "Open one immutable saved result belonging to the selected Coding conversation and round.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "session-id": {
            "type": "string"
          },
          "work-id": {
            "type": "string"
          },
          "result-id": {
            "type": "string"
          }
        },
        "required": [
          "session-id",
          "work-id",
          "result-id"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string"
          },
          "workId": {
            "type": "string"
          },
          "resultId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "patch": {
            "type": "string"
          },
          "limited": {
            "type": "boolean"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "omitted": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "text",
                "omitted"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sessionId",
          "workId",
          "resultId",
          "message",
          "patch",
          "limited",
          "files"
        ],
        "additionalProperties": false
      }
    }
  ]
}
