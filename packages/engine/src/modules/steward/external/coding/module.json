{
  "name": "coding",
  "description": "Headless project coding conversations, durable command receipts and immutable results.",
  "entry": "index.ts",
  "listen": "/api/coding",
  "keepAlive": true,
  "content": true,
  "effects": [],
  "authority": "owner",
  "uses": [
    "*",
    "agent.work-projects",
    "agent.work-run",
    "agent.work-get",
    "agent.work-lookup",
    "agent.work-write",
    "agent.work-respond",
    "agent.work-interrupt",
    "agent.work-stream",
    "agent.work-inspect"
  ],
  "tools": [
    {
      "name": "command",
      "description": "Unified Coding command JSON. See protocol.md for projects, conversations, rounds, history, results and durable receipts.",
      "visibility": [
        "owner"
      ],
      "parameters": {
        "type": "object",
        "properties": {
          "input": {
            "type": "string",
            "description": "Strict Coding command object encoded as JSON; at most 32 KiB."
          }
        },
        "required": [
          "input"
        ]
      },
      "idempotent": false,
      "output": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "data": {
    "schema": 2
  },
  "tests": [
    "test.ts"
  ]
}
