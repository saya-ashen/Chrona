          {
            "type": "object",
            "properties": {
              "provider": {
                "type": "string"
              },
              "autoRecall": {
                "type": "boolean"
              },
              "autoRetain": {
                "type": "boolean"
              }
            },
            "required": [
              "provider",
              "autoRecall",
              "autoRetain"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "ignored": {
                "const": "no caller"
              }
            },
            "required": [
              "ignored"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    {
      "name": "ui-preferences",
      "description": "Read provider-owned saved preferences or delete one preference.",
      "visibility": [
        "owner"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "forget": {
            "type": "string"
