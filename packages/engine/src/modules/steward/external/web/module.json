    {
      "name": "page-set",
      "output": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "revision"
        ],
        "additionalProperties": false
      },
      "description": "Register an active caller-owned executable page. Web binds identity, approved hash, revision and declared own tools. Shared React/UI runtime: /pages.js. See web.catalog and UI-DEVELOPMENT.md.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "parameters": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Page slug, e.g. main"
          },
          "title": {
            "type": "string"
          },
          "layout": {
            "type": "string",
            "enum": [
              "document",
              "workspace"
            ],
            "description": "document: centered max-width 64rem and padding; workspace: full main width without padding, still inside host navigation. Only shared Workspace computes remaining viewport height; arbitrary components must size themselves. Avoid fixed 900px/100vh assumptions. See web.catalog and UI-DEVELOPMENT.md."
          },
          "content": {
            "type": "object",
            "properties": {
              "tool": {
                "type": "string"
              }
            },
            "required": [
              "tool"
            ],
            "additionalProperties": false,
            "description": "Own visible tool accepting {ref}, returning null or {base64,mime} for bounded raster images; see web.catalog."
          },
          "purpose": {
            "type": "string",
            "enum": [
              "settings"
            ],
            "description": "Marks this app-owned settings page for navigation; at most one settings page per app."
          },
          "javascript": {
            "type": "string",
            "description": "ESM default export mount(element,host); import shared React/createRoot/ui from /pages.js only."
          },
          "css": {
            "type": "string"
          },
          "props": {
            "type": "object",
            "properties": {},
            "additionalProperties": true
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "javascript"
        ]
      }
    },
