{
  "name": "events",
  "description": "Events between modules: publishers register their declarations with events.register, others subscribe one of their tools, and each emit is delivered to the subscribers.",
  "entry": "index.ts",
  "keepAlive": true,
  "activated": true,
  "effects": [],
  "uses": [
    "modules.list",
    "modules.tools"
  ],
  "tools": [
    {
      "name": "register",
      "description": "Replace the caller's event declarations. Call when activated; emits is a JSON array of up to 20 {name, description?, payload?} declarations, at most 32 KiB. Own names match [a-z][a-z0-9-]{1,40}; [] withdraws all. Payload schemas allow only type:object, required field names and properties with shallow JSON types. Identity and active hash come from the real caller.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "output": {
        "type": "object",
        "properties": {
          "registered": {
            "type": "boolean"
          }
        },
        "required": [
          "registered"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
        "required": [
          "emits"
        ],
        "properties": {
          "emits": {
            "type": "string",
            "description": "JSON array (20 declarations, 32 KiB): {name, description? (300 chars), payload?}. Payload: {type?:object, required?:string[], properties?:{field:{type?}}}. Max 100 fields, names 128 chars. Types: string, number, integer, boolean, object, array, null. Unknown fields rejected."
          }
        }
      }
    },
    {
      "name": "emit",
      "description": "Emit an event the active caller registered with events.register; delivered to each subscriber as { event, from, payload }.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "output": {
        "type": "object",
        "properties": {
          "delivered": {
            "type": "integer"
          }
        },
        "required": [
          "delivered"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
        "required": [
          "event",
          "payload",
          "key"
        ],
        "properties": {
          "event": {
            "type": "string",
            "description": "The event's own name, without the module name"
          },
          "payload": {
            "type": "string",
            "description": "JSON object matching the declared payload, at most 64 KiB"
          },
          "key": {
            "type": "string",
            "description": "Idempotency key, derived from what happened"
          }
        }
      }
    },
    {
      "name": "subscribe",
      "description": "Deliver <module>.<event> to one of the caller's own tools, which must be visible to modules and take event, from and payload (strings).",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "output": {
        "type": "object",
        "properties": {
          "subscribed": {
            "type": "boolean"
          }
        },
        "required": [
          "subscribed"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
        "required": [
          "event",
          "tool"
        ],
        "properties": {
          "event": {
            "type": "string",
            "description": "<module>.<event>"
          },
          "tool": {
            "type": "string",
            "description": "The caller's own tool"
          }
        }
      }
    },
    {
      "name": "unsubscribe",
      "description": "Stop delivering <module>.<event> to the caller's tool.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "output": {
        "type": "object",
        "properties": {
          "unsubscribed": {
            "type": "boolean"
          }
        },
        "required": [
          "unsubscribed"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object",
        "required": [
          "event",
          "tool"
        ],
        "properties": {
          "event": {
            "type": "string"
          },
          "tool": {
            "type": "string"
          }
        }
      }
    },
    {
      "name": "subscriptions",
      "description": "The caller's subscriptions.",
      "visibility": [
        "modules"
      ],
      "idempotent": true,
      "output": {
        "type": "object",
        "properties": {
          "subscriptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "event": {
                  "type": "string"
                },
                "module": {
                  "type": "string"
                },
                "tool": {
                  "type": "string"
                }
              },
              "required": [
                "event",
                "module",
                "tool"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "subscriptions"
        ],
        "additionalProperties": false
      },
      "parameters": {
        "type": "object"
      }
    }
  ],
  "data": {
    "schema": 1
  },
  "tests": [
    "test.ts"
  ]
}
