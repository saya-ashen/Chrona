{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "entry": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.(ts|py|sh)$"
        },
        {
          "type": "object",
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "args": {
              "default": [],
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "runtime": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            }
          },
          "required": [
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "tools": {
      "default": [],
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "output": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "examples": {
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string",
                  "maxLength": 300
                },
                "args": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "$ref": "#/$defs/__schema1"
                  }
                },
                "result": {
                  "$ref": "#/$defs/__schema2"
                }
              },
              "required": [
                "args"
              ],
              "additionalProperties": false
            }
          },
          "sideEffects": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "errors": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "recovery": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "code",
                "description",
                "recovery"
              ],
              "additionalProperties": false
            }
          },
          "parameters": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "properties": {
                "default": {},
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "additionalProperties": {}
              },
              "required": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          },
          "visibility": {
            "default": [
              "provider",
              "owner"
            ],
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "provider",
                "owner",
                "modules",
                "kernel"
              ]
            }
          },
          "idempotent": {
            "default": false,
            "type": "boolean"
          },
          "readOnly": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "name",
          "description",
          "output",
          "parameters"
        ],
        "additionalProperties": false
      }
    },
    "keepAlive": {
      "default": false,
      "type": "boolean"
    },
    "activated": {
      "default": false,
      "type": "boolean"
    },
    "content": {
      "default": false,
      "type": "boolean"
    },
    "listen": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "string",
              "const": "/"
            },
            {
              "type": "string",
              "pattern": "^\\/api\\/[a-z][a-z0-9-]{1,40}$"
            }
          ]
        },
        {
          "minItems": 1,
          "maxItems": 4,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "const": "/"
              },
              {
                "type": "string",
                "pattern": "^\\/api\\/[a-z][a-z0-9-]{1,40}$"
              }
            ]
          }
        }
      ]
    },
    "uses": {
      "default": [],
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,40}\\.[a-z][a-z0-9-]{1,40}$"
          },
          {
            "type": "string",
            "const": "*"
          }
        ]
      }
    },
    "authority": {
      "type": "string",
      "const": "owner"
    },
    "packages": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,80}$"
      }
    },
    "secrets": {
      "default": [],
      "maxItems": 50,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,40}$"
          },
          {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{1,40}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "fields": {
                "default": [],
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,40}$"
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "optional": {
                      "type": "boolean"
                    },
                    "plain": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "name",
                    "label"
                  ],
                  "additionalProperties": false
                }
              },
              "extraFields": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "valueLabel": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "description": {
                    "type": "string",
                    "maxLength": 300
                  }
                },
                "required": [
                  "label",
                  "valueLabel"
                ],
                "additionalProperties": false
              },
              "oauth": {
                "type": "object",
                "properties": {
                  "provider": {
                    "type": "string",
                    "enum": [
                      "google",
                      "microsoft"
                    ]
                  },
                  "scopes": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    }
                  },
                  "accounts": {
                    "type": "boolean"
                  },
                  "authorizationUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "tokenUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "authorizationParams": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string",
                      "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$"
                    },
                    "additionalProperties": {
                      "type": "string",
                      "maxLength": 2000
                    }
                  }
                },
                "required": [
                  "provider",
                  "scopes",
                  "authorizationUrl",
                  "tokenUrl"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "model": {
      "type": "object",
      "properties": {
        "tier": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,20}$"
        },
        "maxCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32000
        }
      },
      "required": [
        "maxCalls",
        "maxOutputTokens"
      ],
      "additionalProperties": false
    },
    "effects": {
      "maxItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "network"
        ]
      }
    },
    "params": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,40}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "number",
              "string",
              "boolean"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "boolean"
              }
            ]
          }
        },
        "required": [
          "type",
          "value"
        ],
        "additionalProperties": false
      }
    },
    "data": {
      "default": {
        "schema": 1
      },
      "type": "object",
      "properties": {
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "migrate": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+\\.(ts|py|sh)$"
        }
      },
      "required": [
        "schema"
      ],
      "additionalProperties": false
    },
    "tests": {
      "minItems": 1,
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]+\\.(ts|py|sh)$"
      }
    }
  },
  "required": [
    "name",
    "entry",
    "effects",
    "tests"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema0"
          }
        }
      ]
    },
    "__schema1": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema1"
          }
        }
      ]
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema2"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/__schema2"
          }
        }
      ]
    }
  }
}
