#!/usr/bin/env node
// Chrona skill-mode launcher.
//
// Resolution order for the real `chrona` binary:
//   1. $CHRONA_CLI       — explicit absolute path set by the runner (preferred)
//   2. `chrona` on PATH  — a globally-installed @chrona/cli binary
//   3. Inlined fallback — runs the same payload locally with node:fetch
//
// Step 3 keeps the skill self-contained so the agent can still drive the
// control plane if neither the runner env nor a global CLI is available
// (e.g. when developing the skill in isolation).

const { spawnSync } = require("node:child_process");
const { existsSync } = require("node:fs");

function fail(message) {
  console.error(message);
  process.exit(1);
}

function tryExec(target, args) {
  if (!target) return null;
  const result = spawnSync(target, args, { stdio: "inherit" });
  if (result.error && result.error.code === "ENOENT") return null;
  return result;
}

const args = process.argv.slice(2);

// 1. Explicit path from the runner
const explicit = process.env.CHRONA_CLI;
if (explicit && existsSync(explicit)) {
  const result = tryExec(explicit, args);
  if (result) process.exit(result.status ?? 1);
}

// 2. Global `chrona` on PATH
const onPath = tryExec("chrona", args);
if (onPath) process.exit(onPath.status ?? 1);

// 3. Inlined fallback — keep the original zero-dep behavior.
const baseUrl = process.env.CHRONA_BASE_URL?.replace(/\/$/, "");
const runToken = process.env.CHRONA_RUN_TOKEN;

if (!baseUrl) fail("CHRONA_BASE_URL is required for Chrona control-plane CLI.");
if (!runToken) fail("CHRONA_RUN_TOKEN is required for Chrona control-plane CLI.");

function take(flag) {
  const index = args.indexOf(flag);
  if (index === -1) return undefined;
  const value = args[index + 1];
  if (!value || value.startsWith("--")) fail(`${flag} requires a value.`);
  return value;
}

function takeAny(...flags) {
  for (const flag of flags) {
    const value = take(flag);
    if (value !== undefined) return value;
  }
  return undefined;
}

async function readJsonFile(flag) {
  const path = take(flag);
  if (!path) return undefined;
  const fs = await import("node:fs/promises");
  try {
    return JSON.parse(await fs.readFile(path, "utf8"));
  } catch (error) {
    fail(`Could not read JSON from ${path}: ${error instanceof Error ? error.message : String(error)}`);
  }
}

async function payload() {
  const [scope, command] = args;
  if (scope === "task" && command === "read") return { kind: "task_read", payload: {} };
  if (scope === "plan" && command === "read") return { kind: "plan_read", payload: {} };
  if (scope === "plan" && command === "output") return { kind: "plan_output", payload: { patches: await readJsonFile("--patches-file"), summary: take("--summary") } };
  if (scope !== "node") fail("Usage: chrona plan output --patches-file <path> | chrona node <complete|condition-select|wait-complete|block|fail> [...]");

  if (command === "output") fail("Use chrona plan output --patches-file <path>");
  if (command === "complete") return { kind: "complete", payload: { summary: take("--summary") } };
  if (command === "condition-select") return { kind: "condition_select", payload: { branchRef: take("--branch"), summary: takeAny("--reason", "--summary") } };
  if (command === "wait-complete") return { kind: "wait_complete", payload: { summary: takeAny("--reason", "--summary") } };
  if (command === "block") return { kind: "block", payload: { reason: takeAny("--reason", "--summary"), actionForm: take("--action-form") } };
  if (command === "fail") return { kind: "fail", payload: { error: take("--error") } };
  fail(`Unknown node command: ${command ?? ""}`);
}

(async () => {
  const body = await payload();
  const response = await fetch(`${baseUrl}/agent/control`, {
    method: "POST",
    headers: {
      "Authorization": `Bearer ${runToken}`,
      "Content-Type": "application/json",
    },
    body: JSON.stringify(body),
  });

  const text = await response.text();
  if (!response.ok) fail(text || `Chrona control request failed with ${response.status}.`);
  process.stdout.write(text ? `${text}\n` : "{}\n");
})();
